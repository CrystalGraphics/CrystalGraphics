// TSR's spatial anti-aliasing (CgTemporalSuperResolution, Medium and up), at the render size. Where the reject pass
// dropped a pixel's history and its neighbourhood's contrast shows, the edge through the pixel is found from its 3x3 and
// followed both ways along its run (tsr.glsl's edge search, on the luma); where along the run the pixel sits gives how
// far across the edge its colour belongs. The update pass moves its samples by that, so a pixel with no history yet is
// no stair.
#pragma kernel Spatial 8 8 image

Properties {
    _Input   ("The render size, and its inverse", vec4) = (1, 1, 1, 1)
    _Spatial ("x the most steps the edge is followed each way, up to 8", vec4) = (3, 0, 0, 0)
    _Luma    ("The reject pass's luma, in x / (x + 0.5)", sampler2D) = "black"
    _AAMask  ("The reject pass's mask: 1 where to anti-alias", sampler2D) = "black"
}

Images {
    OFFSET ("x the offset across the edge, 4 bits an axis (tsr_encode_offset); y the noise filtering, over 255", rg8ui, writeonly)
}

#include "crystalgraphics:shaders/post/tsr/tsr.glsl"

float luma_at(ivec2 p) {
    return texelFetch(_Luma, clamp(p, ivec2(0), ivec2(_Input.xy) - 1), 0).r;
}

void Spatial() {
    ivec2 p = CG_TEXEL.xy;
    vec2 offset = vec2(0.0);
    float noise = 0.0;
    if (texelFetch(_AAMask, p, 0).r > 0.0) {
        float c = luma_at(p);
        ivec2 along, side;
        float edge;
        tsr_edge_direction(c, luma_at(p + ivec2(0, -1)), luma_at(p + ivec2(0, 1)), luma_at(p + ivec2(-1, 0)),
                luma_at(p + ivec2(1, 0)), luma_at(p + ivec2(-1, -1)), luma_at(p + ivec2(1, -1)), luma_at(p + ivec2(-1, 1)),
                luma_at(p + ivec2(1, 1)), noise, along, side, edge);
        if (abs(edge - c) * 0.5 > TSR_MIN_ALIASING_LUMA) {
            // Each tap sits halfway onto the edge, so bilinear reads the mean of the pixel's row and the edge's
            int steps = int(_Spatial.x);
            vec2 stride = vec2(along) * _Input.zw;
            vec2 uv = (vec2(p) + 0.5 + vec2(side) * 0.5) * _Input.zw;
            vec2 uvMin = 0.5 * _Input.zw, uvMax = 1.0 - 0.5 * _Input.zw;
            float tapsP[TSR_MOST_EDGE_STEPS], tapsN[TSR_MOST_EDGE_STEPS];
            for (int i = 0; i < TSR_MOST_EDGE_STEPS; i++) {   // LOOP-BOUND: _Spatial.x steps, at most 8
                tapsP[i] = 0.0;
                tapsN[i] = 0.0;
                if (i >= steps) continue;
                tapsP[i] = textureLod(_Luma, min(uv + stride * float(i + 1), uvMax), 0.0).r;
                tapsN[i] = textureLod(_Luma, max(uv - stride * float(i + 1), uvMin), 0.0).r;
            }
            int lengthP, lengthN;
            bool growP, growN, shrinkP, shrinkN;
            tsr_edge_run(c, edge, tapsP, tapsN, steps, lengthP, lengthN, growP, growN, shrinkP, shrinkN);
            offset = vec2(side) * tsr_distance_to_edge(growN, growP, shrinkN, shrinkP, lengthN, lengthP);
        }
    }
    OFFSET_WRITE(uvec4(tsr_encode_offset(offset), uint(round(noise * 255.0)), 0u, 0u));
}
