// CgVfxModules' flipbook sheets and stamps, a texel a thread: a sheet is _Columns frames across of _Cell texels each,
// frame 0 at texel row 0, v up each cell. Straight-alpha RGBA.
#pragma kernel Smoke 8 8 image
#pragma kernel Fire 8 8 image
#pragma kernel Wisp 8 8 image
#pragma kernel Dot 8 8 image
#pragma kernel Star 8 8 image
#pragma kernel Rune 8 8 image
#pragma kernel Ring 8 8 image
#pragma kernel Shard 8 8 image

Properties {
    _Columns ("Frames across the sheet", int) = 1
    _Cell    ("Texels a frame a side",  int) = 128
}

Images {
    SHEET ("The sheet", rgba8, writeonly)
}

const float PI = 3.14159265359;
const int MOST_OCTAVES = 5;

// This texel's frame, and (u, v) 0..1 across it, v up.
int frame_of(out vec2 uv) {
    ivec2 t = CG_TEXEL.xy;
    uv = vec2((float(t.x % _Cell) + 0.5) / float(_Cell), 1.0 - (float(t.y % _Cell) + 0.5) / float(_Cell));
    return (t.y / _Cell) * _Columns + t.x / _Cell;
}

float smooth_step(float e0, float e1, float x) {
    float t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

float hash(int x, int y) {
    uint h = uint(x) * 374761393u + uint(y) * 668265263u;
    h = (h ^ (h >> 13)) * 1274126177u;
    return float((h ^ (h >> 16)) & 0xFFFFFFu) / 16777215.0;
}

// Smooth value noise, 0..1.
float value_noise(vec2 p) {
    vec2 i = floor(p), f = p - i;
    f = f * f * (3.0 - 2.0 * f);
    int ix = int(i.x), iy = int(i.y);
    float a = hash(ix, iy), b = hash(ix + 1, iy), c = hash(ix, iy + 1), d = hash(ix + 1, iy + 1);
    return a + (b - a) * f.x + (c - a) * f.y + (a - b - c + d) * f.x * f.y;
}

// Octaves doubling in frequency, halving in weight, turned so they never line up; 0..1.
float fbm(vec2 p, int octaves) {
    float sum = 0.0, amplitude = 0.5, norm = 0.0;
    for (int k = 0; k < min(octaves, MOST_OCTAVES); k++) {
        sum += amplitude * value_noise(p);
        norm += amplitude;
        p = vec2(0.8 * p.x - 0.6 * p.y, 0.6 * p.x + 0.8 * p.y) * 2.03 + vec2(1.7, -0.9);
        amplitude *= 0.5;
    }
    return sum / norm;
}

// The puff's density at p in its own units (radius about 0.5) at t, 0..1.
float smoke_density(vec2 p, float t) {
    float wx = fbm(vec2(p.x * 2.2 + 3.1, p.y * 2.2 - t * 0.6), 3) - 0.5;
    float wy = fbm(vec2(p.x * 2.2 - 1.7 + t * 0.4, p.y * 2.2 + 5.3), 3) - 0.5;
    float d = fbm(vec2(p.x * 3.0 + wx * 1.6, p.y * 3.0 + wy * 1.6 - t * 0.8), 5);
    float r = length(p) * 2.0;
    float body = 1.0 - smooth_step(0.3 - 0.1 * t, 1.05, r + (d - 0.5) * (0.8 + 0.6 * t));
    return clamp(body * (0.5 + 1.1 * (d - 0.3)), 0.0, 1.0);
}

// A smoke puff over 64 frames: a domain-warped billow swelling out of a tight core, thinning to wisps, lit from above
// by how much of itself lies between each point and the light.
void Smoke() {
    vec2 uv;
    float t = float(frame_of(uv)) / 63.0;
    float grow = 0.5 + 0.5 * (1.0 - (1.0 - t) * (1.0 - t));
    vec2 p = (uv - 0.5) / grow;
    float density = smoke_density(p, t);
    float shadow = smoke_density(p + vec2(-0.05, 0.12), t) + 0.5 * smoke_density(p + vec2(-0.1, 0.24), t);
    float shade = 0.38 + 0.62 * exp(-1.8 * shadow);
    SHEET_WRITE(vec4(shade, shade, shade * 1.03, density * (1.0 - 0.8 * t * t)));
}

float flame_noise(vec2 uv, float t) {
    return fbm(vec2(uv.x * 5.0 + 7.3, uv.y * 3.0 - t * 4.0), 4);
}

// A blackbody-like ramp by heat: dark red, orange, yellow, pale yellow. Each stop a heat, then RGB.
const vec4 FLAME_STOPS[5] = vec4[5](vec4(0.0, 0.25, 0.02, 0.0), vec4(0.3, 0.85, 0.18, 0.02), vec4(0.55, 1.0, 0.45, 0.05),
        vec4(0.8, 1.0, 0.75, 0.25), vec4(1.0, 1.0, 0.92, 0.6));

vec3 flame_colour(float heat) {
    int i = 1;
    while (i < 4 && heat > FLAME_STOPS[i].x) i++;   // LOOP-BOUND: the five stops
    float k = clamp((heat - FLAME_STOPS[i - 1].x) / (FLAME_STOPS[i].x - FLAME_STOPS[i - 1].x), 0.0, 1.0);
    return mix(FLAME_STOPS[i - 1].yzw, FLAME_STOPS[i].yzw, k);
}

// A flame over 16 frames that loop: a teardrop wide at its base, its tongues torn upward by rising noise, coloured by
// temperature.
vec4 fire(int frame, vec2 uv) {
    float t = float(frame) / 16.0;
    float a = flame_noise(uv, t), b = flame_noise(uv, t - 1.0);
    float n = a + (b - a) * t;
    float dx = uv.x - 0.5 + (n - 0.5) * 0.3 * uv.y;
    float width = 0.34 * pow(1.0 - uv.y, 0.6) + 0.02;
    float shape = 1.0 - smooth_step(0.15, 1.0, abs(dx) / width);
    float heat = clamp((shape * (1.05 - uv.y * 1.1) + (n - 0.5) * 0.8 * uv.y) * smooth_step(0.0, 0.08, uv.y), 0.0, 1.0);
    return vec4(flame_colour(heat), smooth_step(0.03, 0.6, heat) * (0.55 + 0.45 * shape));
}

void Fire() {
    vec2 uv;
    int frame = frame_of(uv);
    SHEET_WRITE(fire(frame, uv));
}

// The flame in grey, brightest where hottest, for a layer's colours to tint.
void Wisp() {
    vec2 uv;
    int frame = frame_of(uv);
    vec4 c = fire(frame, uv);
    SHEET_WRITE(vec4(vec3(clamp(0.2 + (c.r + c.g + c.b) / 2.5, 0.0, 1.0)), c.a));
}

void Dot() {
    vec2 uv;
    frame_of(uv);
    float r = length(uv - 0.5) * 2.0;
    SHEET_WRITE(vec4(1.0, 1.0, 1.0, exp(-r * r * 5.0) * smooth_step(1.0, 0.85, r)));
}

// A four-pointed glint: thin rays along u and v, fainter diagonals, round a bright core.
void Star() {
    vec2 uv;
    frame_of(uv);
    vec2 d = abs(uv - 0.5) * 2.0;
    float rays = exp(-d.x * 30.0) * max(0.0, 1.0 - d.y) + exp(-d.y * 30.0) * max(0.0, 1.0 - d.x);
    float ex = (d.x + d.y) * 0.7071, ey = abs(d.x - d.y) * 0.7071;
    float diagonal = 0.4 * exp(-ey * 40.0) * max(0.0, 1.0 - ex * 1.6);
    SHEET_WRITE(vec4(1.0, 1.0, 1.0, clamp(rays + diagonal + exp(-dot(d, d) * 25.0), 0.0, 1.0)));
}

// Ink of a stroke halfWidth wide at distance from its middle, antialiased over a texel or so.
float line(float distance, float halfWidth) {
    return 1.0 - smooth_step(halfWidth - 0.012, halfWidth + 0.012, distance);
}

float segment(vec2 p, vec2 a, vec2 b) {
    vec2 e = b - a;
    float t = clamp(dot(p - a, e) / dot(e, e), 0.0, 1.0);
    return length(p - a - e * t);
}

// A rune circle: two rings, ticks between them, and a triangle inside.
void Rune() {
    vec2 uv;
    frame_of(uv);
    vec2 p = (uv - 0.5) * 2.0;
    float r = length(p);
    float ink = max(line(abs(r - 0.9), 0.035), line(abs(r - 0.66), 0.02));
    float angle = atan(p.y, p.x), spoke = PI / 8.0;
    float tick = abs(angle - spoke * roundEven(angle / spoke)) * r;
    if (r > 0.7 && r < 0.86) ink = max(ink, line(tick, 0.018));
    for (int k = 0; k < 3; k++) {
        float a0 = PI / 2.0 + float(k) * 2.0 * PI / 3.0, a1 = a0 + 2.0 * PI / 3.0;
        ink = max(ink, line(segment(p, 0.62 * vec2(cos(a0), sin(a0)), 0.62 * vec2(cos(a1), sin(a1))), 0.022));
    }
    SHEET_WRITE(vec4(1.0, 1.0, 1.0, max(ink, 0.12 * (1.0 - smooth_step(0.6, 0.95, r)))));
}

// A shockwave: a bright thin edge trailing a soft glow inward.
void Ring() {
    vec2 uv;
    frame_of(uv);
    float r = length(uv - 0.5) * 2.0;
    float edge = (r - 0.88) / 0.04, trail = (r - 0.72) / 0.16;
    float a = (exp(-edge * edge) + 0.35 * exp(-trail * trail)) * (r < 0.98 ? 1.0 : 0.0);
    SHEET_WRITE(vec4(1.0, 1.0, 1.0, clamp(a, 0.0, 1.0)));
}

// An ice shard: a long diamond, one facet lit and one in shade, a bright ridge between and a bright rim.
void Shard() {
    vec2 uv;
    frame_of(uv);
    float dx = (uv.x - 0.5) / 0.22, dy = (uv.y - 0.5) / 0.47, d = abs(dx) + abs(dy);
    float shade = dx > 0.0 ? 1.0 : 0.55, ridge = exp(-dx * dx * 60.0), rim = smooth_step(0.7, 0.95, d);
    float c = clamp(shade * (0.6 + 0.4 * rim) + ridge * 0.5, 0.0, 1.0);
    SHEET_WRITE(vec4(c, c, c, (1.0 - smooth_step(0.9, 1.0, d)) * (0.55 + 0.45 * max(rim, ridge))));
}
