// The world's shadowed lighting filtered across the screen where the temporal pass left it noisy, as Unreal's MegaLights
// does (MegaLightsDenoiserSpatial.usf's DenoiserSpatialCS): a few samples on a disk round each pixel, weighed by how
// near their plane is, how alike their normal and how near their luminance within the pixel's spread. Its spread is
// the temporal moments', or for the first frames after a disocclusion a 5x5 Gaussian of them, doubled, with twice the
// samples. A pixel filters only where its relative spread or its history's spatial spread says it is noisy. The sun's
// and the block light's visibility (VISIBILITY) are filtered by the same rule, each from its own moments, a neighbour
// weighed by how near its visibility is within the pixel's spread: a lit pixel keeps no shadow from a pixel beside it.
// The pass samples the stage's depth (CgComputePass.sceneDepth). Its 5x5 reads of the moments come from the group's
// tile, loaded into shared memory once with a border of 2, as MegaLightsDenoiserSpatial.usf does.
#pragma kernel Denoise 8 8 general
#include "crystalgraphics:shaders/lib/math.glsl"
#include "crystalgraphics:shaders/lib/color.glsl"
#include "crystalgraphics:shaders/world/lights/shadow.glsl"

Properties {
    _Rays    ("Unit-depth view rays at the target's edges: left, bottom, right, top", vec4) = (-1, -1, 1, 1)
    _ToView0 ("Eye-relative world to the bobbed view, the first row, its shift in w", vec4) = (1, 0, 0, 0)
    _ToView1 ("The second row",                                    vec4) = (0, 1, 0, 0)
    _ToView2 ("The third row",                                     vec4) = (0, 0, 1, 0)
    _Depth   ("The perspective's m22, m32, m23 and m33: window depth to eye depth", vec4) = (1, 0, -1, 0)
    _Lighting ("The accumulated lighting and frames",              sampler2D) = "black"
    _Moments  ("The accumulated moments, eye depth and confidence", sampler2D) = "black"
    _Vis      ("The accumulated sun and block light visibility, then their squares", sampler2D) = "white"
    _GBuffer  ("Each pixel's normal in the view (gbuffer.compute)", sampler2D) = "black"
    _Spatial ("KernelRadius, NumSamples, DepthWeightScale, MaxDisocclusionFrames", vec4) = (8, 4, 10000, 2)
    _Spread  ("DisocclusionDiffuseSpatialVarianceScale, HistorySpatialStdDevThreshold, MaxFramesAccumulated", vec4) = (2, 0.15, 12, 0)
    _Scale   ("Target pixels a texel spans each way: 1, 2 or 4 (crystalgraphics.world.lightsShadeScale)", int) = 1
}

Images {
    FILTERED   ("The filtered lighting, alpha 1 where lit",               rgba16f, writeonly)
    VISIBILITY ("The filtered sun and block light visibility, alpha 1",   rgba16f, writeonly)
}

// The group's 8x8 moments and a border of 2 each way, each texel clamped to the target as the reads were.
const int TILE = 12;
shared vec4 tileMoments[TILE * TILE];

// The moments at px + o, o within 2 of a texel of this group: from the tile.
vec4 moments_near(ivec2 px, ivec2 o) {
    ivec2 t = px + o - (CG_GROUP_ID.xy * CG_LOCAL_SIZE.xy - 2);
    return tileMoments[t.y * TILE + t.x];
}

float eye_depth(ivec2 px) {
    px = clamp(px, ivec2(0), ivec2(CG_RESOLUTION) - 1);
    float window = texelFetch(cg_DepthBuffer, px, 0).r;
    if (cg_DepthParams.x > 0.5 ? window <= 0.0 : window >= 1.0) return 0.0;
    float ndc = cg_EngineDepth(window);
    return _Depth.z == 0.0 ? (_Depth.y - ndc) / _Depth.x
            : (_Depth.y - _Depth.x / _Depth.z * _Depth.w) / (ndc - _Depth.x / _Depth.z);
}

// Texel px's surface and normal: the target pixel it stands for, its first at half resolution.
vec3 surface(ivec2 px) {
    px *= _Scale;
    float depth = eye_depth(px);
    vec2 uv = (vec2(clamp(px, ivec2(0), ivec2(CG_RESOLUTION) - 1)) + 0.5) / CG_RESOLUTION;
    return vec3(mix(_Rays.xy, _Rays.zw, uv) * depth, -depth);
}

// Pixel px's normal in the view, written once a firing (gbuffer.compute, Unreal's GBufferA in role).
vec3 normal_at(ivec2 px) { return texelFetch(_GBuffer, clamp(px * _Scale, ivec2(0), ivec2(CG_RESOLUTION) - 1), 0).xyz; }

void filter_at(ivec2 px, out vec4 lighting, out vec4 visibility) {
    ivec2 size = textureSize(_Lighting, 0);
    vec4 centre = texelFetch(_Lighting, px, 0);
    vec4 visMoments = texelFetch(_Vis, px, 0);
    vec2 vis = visMoments.xy;
    lighting = vec4(0.0);
    visibility = vec4(1.0);
    float frames = centre.a;
    if (frames <= 0.0) return;
    lighting = vec4(centre.rgb, 1.0);
    visibility = vec4(vis, 0.0, 1.0);

    // Boost the filter until enough frames are in for the temporal variance to be trusted.
    float most = min(_Spatial.w, _Spread.z - 1.0);
    float disocclusion = most > 0.0 ? 1.0 - clamp((frames - 1.0) / most, 0.0, 1.0) : 0.0;
    vec4 moments;
    if (disocclusion > 0.01) {
        moments = vec4(0.0);
        float weightSum = 0.0;
        for (int y = -2; y <= 2; y++) {
            for (int x = -2; x <= 2; x++) {
                float w = exp2(-2.0 * float(x * x + y * y) / 9.0);
                moments += moments_near(px, ivec2(x, y)) * w;
                weightSum += w;
            }
        }
        moments /= weightSum;
    } else {
        moments = texelFetch(_Moments, px, 0);
    }
    float stdDev = sqrt(max(moments.y - moments.x * moments.x, 0.0));
    vec2 visStdDev = sqrt(max(visMoments.zw - vis * vis, vec2(0.0)));
    bool filtering, noisy = false;
    bvec2 filterVis;
    if (disocclusion > 0.01) {
        stdDev *= _Spread.x;
        visStdDev *= _Spread.x;
        filtering = stdDev / max(moments.x, 0.1) > 0.2;
        filterVis = greaterThan(visStdDev / max(vis, vec2(0.1)), vec2(0.2));
    } else {
        // GetHistoryConfidenceSpatialStdDev: how unevenly the history was trusted round this pixel.
        float sum = 0.0, squares = 0.0, n = 0.0;
        for (int y = -2; y <= 2; y++) {
            for (int x = -2; x <= 2; x++) {
                if (x == 0 && y == 0 || abs(x) == 2 && abs(y) == 2) continue;
                float c = moments_near(px, ivec2(x, y)).w;
                sum += c;
                squares += c * c;
                n += 1.0;
            }
        }
        float m1 = sum / n;
        noisy = sqrt(max(squares / n - m1 * m1, 0.0)) > _Spread.y;
        filtering = (_Spread.z >= 8.0 || noisy) && _Spread.z > 1.0 && (stdDev / max(moments.x, 0.1) > 0.5 || noisy);
        vec2 relative = visStdDev / max(vis, vec2(0.1));
        filterVis = bvec2(relative.x > 0.5 || noisy, relative.y > 0.5 || noisy);
    }
    if (_Spatial.x <= 0.0 || !filtering && !any(filterVis)) return;

    vec3 p = surface(px), n = normal_at(px);
    float centreLum = luminance(centre.rgb);
    vec3 sum = centre.rgb;
    float weightSum = 1.0;
    vec2 visWeight = vec2(1.0);
    vec2 visSum = vis;
    uvec2 seed = cg_rand_pcg16(ivec3(px % 2, CG_FRAME_INDEX)).xy;
    uint count = uint(mix(_Spatial.y, 2.0 * _Spatial.y, disocclusion) + 0.5);
    for (uint k = 0u; k < count; k++) {   // LOOP-BOUND: twice _Spatial.y, 4 from CgWorldLights
        vec2 offset = cg_disk_concentric(cg_hammersley16(k, count, seed)) * _Spatial.x;
        ivec2 q = ivec2(vec2(px) + offset + 0.5);
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
        vec4 neighbour = texelFetch(_Lighting, q, 0);
        if (neighbour.a <= 0.0) continue;
        vec3 s = surface(q);
        if (s.z >= 0.0) continue;
        float relative = abs(dot(s - p, n)) / -p.z;
        float depthWeight = exp2(-_Spatial.z * relative * relative);
        float normalWeight = 1.0 - clamp(acos(clamp(dot(n, normal_at(q)), 0.0, 1.0)), 0.0, 1.0);
        float geometry = depthWeight * normalWeight;
        if (filtering) {
            float w = geometry * exp2(-abs(centreLum - luminance(neighbour.rgb)) / max(stdDev, 0.001));
            sum += neighbour.rgb * w;
            weightSum += w;
        }
        if (any(filterVis)) {
            vec2 q2 = texelFetch(_Vis, q, 0).xy;
            vec2 w = geometry * exp2(-abs(vis - q2) / max(visStdDev, vec2(0.001))) * vec2(filterVis);
            visSum += q2 * w;
            visWeight += w;
        }
    }
    if (filtering) lighting = vec4(sum / weightSum, 1.0);
    visibility = vec4(visSum / visWeight, 0.0, 1.0);
}

void Denoise() {
    // Every invocation loads, then waits: a general kernel's barrier is reached by the whole group
    ivec2 base = CG_GROUP_ID.xy * CG_LOCAL_SIZE.xy - 2, size = textureSize(_Moments, 0);
    for (int i = CG_LOCAL_INDEX; i < TILE * TILE; i += CG_GROUP_SIZE) {   // LOOP-BOUND: 144 over the group's 64
        tileMoments[i] = texelFetch(_Moments, clamp(base + ivec2(i % TILE, i / TILE), ivec2(0), size - 1), 0);
    }
    memoryBarrierShared();
    barrier();
    if (!CG_IN_RANGE) return;
    vec4 lighting, visibility;
    filter_at(CG_TEXEL.xy, lighting, visibility);
    FILTERED_WRITE(lighting);
    VISIBILITY_WRITE(visibility);
}
