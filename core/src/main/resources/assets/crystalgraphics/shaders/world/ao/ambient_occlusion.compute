// Screen-space ambient occlusion, Unreal's SSAO (CgAmbientOcclusion, r.AmbientOcclusion.Method 0) on its forward path:
// one level (forward runs one), run once the scene's depth holds every opaque surface and read by the lit solids as
// indirect occlusion. Rotated pairs of samples about the pixel, each side keeping its highest horizon, (1 - horizon)^2
// its open fraction; 3 directions at shader levels 0-3 with 1, 1, 2, 3 steps, 6 directions with 3 at level 4. Written
// from that shape. One texture out, 1 unoccluded, Unreal's fade, power and intensity applied. GTAO is gtao.compute,
// CACAO cacao.compute.
#pragma kernel Ssao 8 8 image

Properties {
    _Size     ("The depth's size, and its inverse", vec4) = (1, 1, 1, 1)
    _Output   ("x intensity, y power, z the fade's multiply, w its add (eye depth, metres)", vec4) = (0.5, 2, 0, 0)
    _Ssao     ("x the radius, y 1 in world space (metres), 0 a share of the screen's height; z the bias; w the shader level", vec4) = (0.125, 0, 0.003, 2)
    _Noise    ("x the frame's index into the noise, 0 where no temporal step resolves it", vec4) = (0, 0, 0, 0)
}

Images {
    AO      ("The occlusion the lit solids read: 1 open", r16f, writeonly)
}

const float AO_PI = 3.14159265;
// The sky's depth, which nothing is behind: a half float's range
const float FAR = 65504.0;

// View depth at pixel px of the scene's depth; FAR for the sky.
float view_depth(ivec2 px) {
    px = clamp(px, ivec2(0), ivec2(_Size.xy) - 1);
    float window = texelFetch(cg_DepthBuffer, px, 0).r;
    if (cg_DepthParams.x > 0.5 ? window <= 0.0 : window >= 1.0) return FAR;
    return min(cg_LinearEyeDepth(window), FAR);
}

// The view position at uv (0 to 1) and positive depth z: x and y as the projection puts them, z away from the eye.
vec3 view_position(vec2 uv, float z) {
    vec2 ndc = uv * 2.0 - 1.0;
    return vec3((ndc.x + cg_ProjMatrix[2][0]) * z / cg_ProjMatrix[0][0], (ndc.y + cg_ProjMatrix[2][1]) * z / cg_ProjMatrix[1][1], z);
}

// The output's mapping, Unreal's: faded to open with distance, then 1 - (1 - ao^power) * intensity.
float shaped(float ao, float z, float power) {
    ao = mix(ao, 1.0, clamp(z * _Output.z + _Output.w, 0.0, 1.0));
    return 1.0 - (1.0 - pow(max(ao, 0.0), power)) * _Output.x;
}

// 1 where a neighbour lies on this pixel's plane, toward 0 across a depth edge.
vec4 edges_of(float c, float l, float r, float t, float b) {
    vec4 e = vec4(l, r, t, b) - c;
    float slopeLR = (e.y - e.x) * 0.5, slopeTB = (e.w - e.z) * 0.5;
    vec4 adjusted = e + vec4(slopeLR, -slopeLR, slopeTB, -slopeTB);
    e = min(abs(e), abs(adjusted));
    return clamp(1.25 - e / (c * 0.011), 0.0, 1.0);
}

// The normal from depth: the four cross products about the pixel, each weighted by its two edges.
vec3 normal_of(vec4 e, vec3 c, vec3 l, vec3 r, vec3 t, vec3 b) {
    vec4 accepted = clamp(vec4(e.x * e.z, e.z * e.y, e.y * e.w, e.w * e.x) + 0.01, 0.0, 1.0);
    l = normalize(l - c);
    r = normalize(r - c);
    t = normalize(t - c);
    b = normalize(b - c);
    vec3 n = accepted.x * cross(l, t) + accepted.y * cross(t, r) + accepted.z * cross(r, b) + accepted.w * cross(b, l);
    n = normalize(n);
    return dot(n, -c) < 0.0 ? -n : n;
}

// ── SSAO ────────────────────────────────────────────────────────────────────────────────────────────────────────

// A 4x4 ordered pattern: each pixel's rotation of the sample set, moved each frame where the temporal step resolves it.
const float BAYER[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);

// One side's horizon at view offset q from p: its rise above the surface, less the bias; and its weight, fading out over
// the radius's far half (Unreal's halo).
vec2 wedge(vec3 p, vec3 n, vec3 q, float radius) {
    vec3 d = q - p;
    float len = length(d);
    float rise = clamp(dot(d / max(len, 1.0e-6), n) - _Ssao.z, 0.0, 1.0);
    return vec2(rise, clamp(2.0 - 2.0 * len / radius, 0.0, 1.0));
}

void Ssao() {
    ivec2 px = CG_TEXEL.xy;
    vec2 pixel = _Size.zw, uv = (vec2(px) + 0.5) * pixel;
    float z = view_depth(px);
    if (z >= FAR) {
        AO_WRITE(vec4(1.0));
        return;
    }
    float lz = view_depth(px - ivec2(1, 0)), rz = view_depth(px + ivec2(1, 0));
    float tz = view_depth(px - ivec2(0, 1)), bz = view_depth(px + ivec2(0, 1));
    vec3 p = view_position(uv, z);
    vec3 n = normal_of(edges_of(z, lz, rz, tz, bz), p, view_position(uv - vec2(pixel.x, 0.0), lz),
            view_position(uv + vec2(pixel.x, 0.0), rz), view_position(uv - vec2(0.0, pixel.y), tz),
            view_position(uv + vec2(0.0, pixel.y), bz));

    // The radius as a share of the screen's height (Unreal's default), or in metres; its reach on screen in uv
    float radius = _Ssao.y > 0.5 ? _Ssao.x : _Ssao.x * 2.0 * z / cg_ProjMatrix[1][1];
    vec2 reach = radius * vec2(cg_ProjMatrix[0][0], cg_ProjMatrix[1][1]) * 0.5 / z;

    int level = int(_Ssao.w);
    int directions = level >= 4 ? 6 : 3;
    int steps = level >= 4 ? 3 : level == 3 ? 3 : level == 2 ? 2 : 1;
    float rotation = (BAYER[(px.y & 3) * 4 + (px.x & 3)] + float(uint(_Noise.x) % 16u)) / 16.0 * AO_PI;

    vec2 total = vec2(0.0);
    for (int i = 0; i < directions; i++) {
        float angle = rotation + float(i) / float(directions) * AO_PI;
        vec2 dir = vec2(cos(angle), sin(angle)) * reach;
        vec2 side0 = vec2(0.0), side1 = vec2(0.0);   // x the highest horizon, y whether any sample counted
        for (int s = 1; s <= steps; s++) {
            vec2 o = dir * (float(s) / float(steps));
            vec2 uv0 = uv + o, uv1 = uv - o;
            vec2 w0 = wedge(p, n, view_position(uv0, view_depth(ivec2(floor(uv0 * _Size.xy)))), radius);
            vec2 w1 = wedge(p, n, view_position(uv1, view_depth(ivec2(floor(uv1 * _Size.xy)))), radius);
            side0 = mix(side0, vec2(max(side0.x, w0.x), 1.0), w0.y);
            side1 = mix(side1, vec2(max(side1.x, w1.x), 1.0), w1.y);
        }
        // The area open above a horizon falls with its square
        total += vec2((1.0 - side0.x) * (1.0 - side0.x) * side0.y, side0.y);
        total += vec2((1.0 - side1.x) * (1.0 - side1.x) * side1.y, side1.y);
    }
    float ao = total.y > 0.0 ? total.x / total.y : 1.0;
    AO_WRITE(vec4(shaped(ao, z, _Output.y)));
}
