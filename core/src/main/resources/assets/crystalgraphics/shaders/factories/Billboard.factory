// Billboard: one camera-facing quad a draw (CgVfxFrame.billboard), a lone particle placed at the draw's centre, its
// half size the transform's scale. v.position is the corner (-1..1 across and up), uv0 the same from 0 to 1.
// cg_Billboard.size is that half size in blocks, .values the four the effect documents for the particle, .right and .up
// the camera's axes in the world; all read in either stage. A material turning the quad places it in vertex(). cg_Vfx
// is the draw's header; an ending's fade is applied for the material.
Factory { VertexType none  Fade cg_Vfx.presence  Usage FX_ON_BILLBOARD }

Declarations {
    #include "crystalgraphics:shaders/lib/vfx/fx_common.glsl"
    #include "crystalgraphics:shaders/lib/vfx/fx_draw.glsl"
    struct CgBillboard { float size; vec4 values; vec3 right; vec3 up; };
    #define cg_Billboard CgBillboard(length(CG_OBJECT_TO_WORLD[0].xyz), CG_OBJECT_CUSTOM1, vec3(cg_ViewMatrix[0][0], cg_ViewMatrix[1][0], cg_ViewMatrix[2][0]), vec3(cg_ViewMatrix[0][1], cg_ViewMatrix[1][1], cg_ViewMatrix[2][1]))
}

void fill(inout CgVertex v) {
    vec2 corner = FX_QUAD_CORNER;
    v.position = vec3(corner, 0.0);
    v.normal = vec3(cg_ViewMatrix[0][2], cg_ViewMatrix[1][2], cg_ViewMatrix[2][2]);
    v.color = vec4(1.0);
    v.uv0 = corner * 0.5 + 0.5;
    v.uv1 = v.uv0;
    v.uv2 = v.uv0;
    v.uv3 = v.uv0;
    v.world = CG_OBJECT_TO_WORLD[3].xyz + (cg_Billboard.right * corner.x + cg_Billboard.up * corner.y) * cg_Billboard.size;
}
