// MeshParticles: a mesh renderer's particles, a mesh an instance a particle, placed, turned and sized by it: Unreal's
// mesh particle vertex factory, through particle_factory.glsl. Its vertex colour and UVs are the mesh's, its colour the
// particle's (cg_Particle.color); v.position is the mesh's own vertex, before the particle places it. A sprite or a
// strip renderer draws the same material as Sprites does, v.position then the corner's offset. cg_TangentToWorld is
// the placed vertex's tangent, bitangent and normal in the world, for a vertex() that needs the whole frame (v.normal
// is its third). cg_Vfx is the draw's header; an ending's fade is applied for the material, and a lit particle is lit
// by its own light.
Factory { VertexType spatial  Parameters cg_Particle  Fade cg_Vfx.presence }
EngineBuffers { particle }

Declarations {
    #include "crystalgraphics:shaders/lib/vfx/fx_draw.glsl"
    CgMaterialParticle cg_Particle;
    mat3 cg_TangentToWorld;
}

Parameters {
    vec4 color;
    float relativeTime;
    float random;
    vec4 velocity;
    vec4 positionAndSize;
    vec2 size;
    float spriteRotation;
    vec2 subUVCoords0;
    vec2 subUVCoords1;
    float subUVLerp;
    flat int record;
    vec4 dynamicParameters[4];
    flat int dynamics;
    vec2 light;
    float opacity;
    float heat;
}

void fill(inout CgVertex v) {
    CgMaterialVertex placed = cg_material_vertex();
    cg_Particle = cg_material_particle();
#ifdef FX_ON_SPRITES
    v.position = placed.worldPosition - cg_Particle.positionAndSize.xyz;
#else
    v.position = cg_Position;
#endif
    cg_TangentToWorld = placed.tangentToWorld;
    v.normal = placed.tangentToWorld[2];
    v.color = placed.vertexColor;
    v.uv0 = placed.texCoords[0];
    v.uv1 = placed.texCoords[1];
    v.uv2 = placed.texCoords[2];
    v.uv3 = placed.texCoords[3];
    v.world = placed.worldPosition;
}

void defaults(inout CgSurface s) {
    s.light = cg_Particle.light;
}
