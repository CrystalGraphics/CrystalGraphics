// FluidVolume: a VFX fluid slot (CgVfxFrame, CgVfxFluid): the box round a fluid's tiles, a unit cube scaled, which the
// material marches from the pixel's ray (fx_scatter_box, lib/vfx/sparse.glsl), drawn on its far wall. The engine binds the
// fluid atlas (_FluidShade: smoke, temperature, sun, sky; _FluidRestA and B, its two UV grids; _FluidPages, each
// fluid's page table). cg_Fluid.index is the fluid's place in the atlas, .cell its cell in blocks, .weight its first
// UV grid's weight, .size the layer's size, .lo and .hi the box, .corner the grid's low corner; read in either stage.
// cg_Vfx is the draw's header; an ending's fade is applied for the material.
Factory { VertexType spatial  Fade cg_Vfx.presence  Usage FX_ON_FLUID_VOLUME }

Properties {
    _FluidShade  ("The fluid atlas's shade: smoke, temperature, sun, sky (CgVfxFluidAtlas)", sampler3D) = "black"
    _FluidRestA  ("Its first UV grid: cells moved since its reset",   sampler3D) = "black"
    _FluidRestB  ("Its second",                                       sampler3D) = "black"
    _FluidPages  ("Each fluid's page table",                          sampler3D) = "black"
}

Declarations {
    #include "crystalgraphics:shaders/lib/vfx/common.glsl"
    #include "crystalgraphics:shaders/lib/vfx/depth.glsl"
    #include "crystalgraphics:shaders/factories/draw.glsl"
    #include "crystalgraphics:shaders/factories/scatter.glsl"
    #include "crystalgraphics:shaders/lib/vfx/sparse.glsl"
    struct CgFluid { int index; float cell; float weight; float size; vec3 lo; vec3 hi; vec3 corner; };
    CgFluid _cg_fluid() {
        vec3 centre = CG_OBJECT_TO_WORLD[3].xyz;
        vec3 half_ = 0.5 * vec3(length(CG_OBJECT_TO_WORLD[0].xyz), length(CG_OBJECT_TO_WORLD[1].xyz), length(CG_OBJECT_TO_WORLD[2].xyz));
        return CgFluid(int(CG_OBJECT_CUSTOM0.x + 0.5), CG_OBJECT_CUSTOM0.y, CG_OBJECT_CUSTOM0.z, CG_OBJECT_CUSTOM0.w,
                centre - half_, centre + half_, centre + CG_OBJECT_CUSTOM1.xyz);
    }
    #define cg_Fluid _cg_fluid()
}

void fill(inout CgVertex v) {
    v.position = cg_Position;
    v.normal = normalize(CG_NORMAL_MATRIX * cg_Normal);
    v.color = vec4(1.0);
    v.uv0 = cg_TexCoord0;
    v.uv1 = v.uv0;
    v.uv2 = v.uv0;
    v.uv3 = v.uv0;
    v.world = (CG_OBJECT_TO_WORLD * vec4(cg_Position, 1.0)).xyz;
}
