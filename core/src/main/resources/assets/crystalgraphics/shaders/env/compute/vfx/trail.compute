// Each particle's trail (CgVfxParticlePool, an emitter's trail(points)): after a step, every live particle of a slot
// that keeps trails stores where it is in its ring, at the step's place in it, tagged with its id. A ring belongs to
// spawn ids alike modulo the slot's capacity, so a reader stops where the tag is another particle's. A scatter, so it
// runs at every tier: below compute, points blended into the history's target.
#pragma kernel Store scatter

#include "crystalgraphics:shaders/lib/vfx/fx_record.glsl"

Properties {
    _Step          ("This step's place in every ring: the steps the pool has stored, modulo a ring's points", int) = 0
    _RecordVectors ("A record's uvec4s: its pool's layout", int) = 4
}

Buffers {
    RECORDS ("Particles, after the step",                                uvec4,    readonly)
    LIVE    ("How many are alive",                                       uint,     readonly)
    RINGS   ("Each slot's rings: first point, rings, points a ring, 0",  uvec4,    readonly)
    HISTORY ("Every ring's points: position from its slot's origin, and 1 + its particle's id", vec4, writeonly)
}

void Store() {
    if (CG_ELEMENT >= int(LIVE(0))) return;
    int e = CG_ELEMENT * _RecordVectors;
    uvec4 heatId = RECORDS(e + FX_RECORD_HEAT_ID);
    uvec4 ring = RINGS(int(heatId.z));
    if (ring.z == 0u) return;
    uint at = ring.x + (heatId.y % ring.y) * ring.z + uint(_Step) % ring.z;
    HISTORY_STORE(int(at), vec4(uintBitsToFloat(RECORDS(e + FX_RECORD_POSITION_AGE).xyz), float(heatId.y & 16777215u) + 1.0));
}
