// CgGpuOps.cull (gpu-compute C9b): instances of one mesh, each placed in the camera-relative world, tested against the
// view's frustum, given the level its screen height picks and, with a depth pyramid, tested against the scene's depth.
// Each kept at this dispatch's level is appended as the object record a draw reads. One dispatch a level, every one
// testing every instance: an append writes one buffer. CgWorldRenderer's tests on the CPU, step for step;
// CgGpuOpsBodies.cull is the CPU tier's twin, line for line.
//
// An ordered cull keeps each level's records in their order: CullFlags marks the instances kept at a level,
// CgGpuOps.compact lists them in order, and CullPlace writes the kept record of each listed one.
//
// Many sets at once (CgCullSets): each set's values are a row of SETS rather than properties. CullKey, once per
// instance buffer, keys each instance of its sets by row and level (_Culled for none); one sort, histogram and scan
// over every set's keys give each level's count and start; CullGather, once per instance buffer, writes each level's
// kept records in their order.
#pragma kernel Cull append
#pragma kernel CullFlags map
#pragma kernel CullPlace gather
#pragma kernel CullKey map
#pragma kernel CullGather gather

#include "crystalgraphics:shaders/lib/occlusion.glsl"

Properties {
    _CountAt      ("The count's word in COUNT, -1 for none",           int)  = -1
    _Capacity     ("Instances dispatched",                             int)  = 0
    _First        ("The first record of INSTANCES read",               int)  = 0
    _Level        ("The level this dispatch keeps",                    int)  = 0
    _Levels       ("Levels by screen height; 0 for one never culled",  int)  = 0
    _Heights0     ("Screen heights of levels 0 to 3",                  vec4) = (0, 0, 0, 0)
    _Heights1     ("Screen heights of levels 4 to 7",                  vec4) = (0, 0, 0, 0)
    _Min          ("The mesh's box, padded: low corner",               vec4) = (0, 0, 0, 0)
    _Max          ("The mesh's box, padded: high corner",              vec4) = (0, 0, 0, 0)
    _Place0       ("Where the set sits, camera-relative: column 0",    vec4) = (1, 0, 0, 0)
    _Place1       ("Column 1",                                         vec4) = (0, 1, 0, 0)
    _Place2       ("Column 2",                                         vec4) = (0, 0, 1, 0)
    _Place3       ("Column 3",                                         vec4) = (0, 0, 0, 1)
    _PlaceNormal0 ("Its normal matrix: column 0",                      vec4) = (1, 0, 0, 0)
    _PlaceNormal1 ("Column 1",                                         vec4) = (0, 1, 0, 0)
    _PlaceNormal2 ("Column 2",                                         vec4) = (0, 0, 1, 0)
    _ClipX        ("Projection times view: row 0",                     vec4) = (1, 0, 0, 0)
    _ClipY        ("Row 1",                                            vec4) = (0, 1, 0, 0)
    _ClipZ        ("Row 2",                                            vec4) = (0, 0, 1, 0)
    _ClipW        ("Row 3",                                            vec4) = (0, 0, 0, 1)
    _Plane0       ("The frustum's planes, JOML's order",               vec4) = (0, 0, 0, 1)
    _Plane1       ("Plane 1",                                                 vec4) = (0, 0, 0, 1)
    _Plane2       ("Plane 2",                                                 vec4) = (0, 0, 0, 1)
    _Plane3       ("Plane 3",                                                 vec4) = (0, 0, 0, 1)
    _Plane4       ("Plane 4",                                                 vec4) = (0, 0, 0, 1)
    _Plane5       ("Plane 5",                                                 vec4) = (0, 0, 0, 1)
    _Eye          ("Projection [2][2], [2][3], [3][2], [3][3]",        vec4) = (-1, -1, 0, 0)
    _ScreenY      ("|projection [1][1]|",                              float) = 1.0
    _Pyramid      ("Eye depth, each level the farthest it covers",     sampler2D) = "white"
    _PyramidSize  ("Its width, height and levels; no levels, no test", vec4) = (0, 0, 0, 0)
    _Light        ("Block and sky light stamped; z 1 to stamp",        vec4) = (0, 0, 0, 0)
    _Customs      ("Bit k set: custom k stamped from _Custom<k>",      int)  = 0
    _Custom0      ("Custom 0 stamped",                                 vec4) = (0, 0, 0, 0)
    _Custom1      ("Custom 1 stamped",                                 vec4) = (0, 0, 0, 0)
    _Custom2      ("Custom 2 stamped",                                 vec4) = (0, 0, 0, 0)
    _Custom3      ("Custom 3 stamped",                                 vec4) = (0, 0, 0, 0)
    _Scale        ("Each instance scaled about its own origin",        float) = 1.0
    _NormalScale  ("What that scale does to a normal matrix",          float) = 1.0
    _SetFirst     ("This instance buffer's first row of SETS",         int)  = 0
    _Sets         ("Its rows",                                         int)  = 0
    _Culled       ("The key of an instance no level keeps",            int)  = 0
}

struct CullRecord {   // CgInstanceKind.OBJECT's 48 floats
    vec4 model0; vec4 model1; vec4 model2; vec4 model3;
    vec4 normal0; vec4 normal1; vec4 normal2; vec4 normal3;
    vec4 custom0; vec4 custom1; vec4 custom2; vec4 custom3;
};

// One set of CgCullSets: what a CgCull holds for it. Its levels' counts are words 8 * row on of COUNTS.
struct CullSet {
    vec4 place0; vec4 place1; vec4 place2; vec4 place3;
    vec4 normal0; vec4 normal1; vec4 normal2;
    vec4 lo;        // the padded box's low corner; w the scale
    vec4 hi;        // its high corner; w what the scale does to a normal matrix
    vec4 heights0; vec4 heights1;
    vec4 light;     // block and sky stamped; z 1 to stamp
    vec4 custom0; vec4 custom1; vec4 custom2; vec4 custom3;
    ivec4 info;     // levels (0: never culled by size), customs stamped, the count's word in COUNT (-1: none), capacity
    ivec4 at;       // its first record of INSTANCES, its first key and its first output record in its dispatch's
};

Buffers {
    COUNT     ("The count",                                uint,       readonly)
    INSTANCES ("Instances",                                CullRecord, readonly)
    OUT       ("Kept",                                     CullRecord, append)
    FLAGS     ("1 for each instance kept at this level",   uint,       writeonly)
    KEPT      ("The kept instances, in order",             uint,       readonly)
    PLACED    ("Each listed instance's kept record",       CullRecord, writeonly)
    SETS      ("Every set's values",                       CullSet,    readonly)
    KEYS      ("Each instance's row and level",            uint,       writeonly)
    INDICES   ("Each instance's record, sorted by key",    uint,       writeonly)
    COUNTS    ("Each set's levels' counts, 8 a row",       uint,       readonly)
    STARTS    ("Where each count's run starts in SORTED",  uint,       readonly)
    SORTED    ("The kept instances' records, by key",      uint,       readonly)
}

bool outside(vec4 plane, vec3 lo, vec3 hi) {
    return plane.x * (plane.x < 0.0 ? lo.x : hi.x) + plane.y * (plane.y < 0.0 ? lo.y : hi.y)
            + plane.z * (plane.z < 0.0 ? lo.z : hi.z) < -plane.w;
}

// The one set a dispatch of the per-set kernels culls, from its properties.
CullSet cull_set() {
    CullSet s;
    s.place0 = _Place0; s.place1 = _Place1; s.place2 = _Place2; s.place3 = _Place3;
    s.normal0 = _PlaceNormal0; s.normal1 = _PlaceNormal1; s.normal2 = _PlaceNormal2;
    s.lo = vec4(_Min.xyz, _Scale);
    s.hi = vec4(_Max.xyz, _NormalScale);
    s.heights0 = _Heights0; s.heights1 = _Heights1;
    s.light = _Light;
    s.custom0 = _Custom0; s.custom1 = _Custom1; s.custom2 = _Custom2; s.custom3 = _Custom3;
    s.info = ivec4(_Levels, _Customs, _CountAt, _Capacity);
    s.at = ivec4(_First, 0, 0, 0);
    return s;
}

// Record r's model matrix, scaled and placed in the camera-relative world.
mat4 cull_model(CullSet s, CullRecord r) {
    float scale = s.lo.w;
    return mat4(s.place0, s.place1, s.place2, s.place3) * mat4(r.model0 * scale, r.model1 * scale, r.model2 * scale, r.model3);
}

// The level an instance of model matrix m is kept at, or -1.
int cull_level(CullSet s, mat4 m) {
    // The box in the camera-relative world: JOML's transformAab, term for term.
    vec3 lo = m[3].xyz, hi = m[3].xyz;
    for (int a = 0; a < 3; a++) {
        vec3 p = m[a].xyz * s.lo[a], q = m[a].xyz * s.hi[a];
        lo += min(p, q);
        hi += max(p, q);
    }
    if (outside(_Plane0, lo, hi) || outside(_Plane1, lo, hi) || outside(_Plane2, lo, hi)
            || outside(_Plane3, lo, hi) || outside(_Plane4, lo, hi) || outside(_Plane5, lo, hi)) return -1;

    int level = 0, levels = s.info.x;
    if (levels > 0) {
        vec3 c = (lo + hi) * 0.5;
        float radius = 0.5 * length(hi - lo);
        float w = dot(_ClipW, vec4(c, 1.0));
        float screen = w <= radius ? 3.4e38 : radius * _ScreenY / w;
        level = -1;
        for (int i = 0; i < levels; i++) {
            float height = i < 4 ? s.heights0[i] : s.heights1[i - 4];
            if (screen >= height) {
                level = i;
                break;
            }
        }
    }
    if (level < 0 || cg_occluded(_Pyramid, _PyramidSize, _ClipX, _ClipY, _ClipZ, _ClipW, _Eye, lo, hi)) return -1;
    return level;
}

// The record a draw reads for r, placed by m: the normal matrix placed and scaled, the stamps applied.
CullRecord cull_record(CullSet s, CullRecord r, mat4 m) {
    mat3 normal = mat3(s.normal0.xyz, s.normal1.xyz, s.normal2.xyz)
            * mat3(r.normal0.xyz, r.normal1.xyz, r.normal2.xyz) * s.hi.w;
    int customs = s.info.y;
    CullRecord o;
    o.model0 = m[0];
    o.model1 = m[1];
    o.model2 = m[2];
    o.model3 = m[3];
    o.normal0 = vec4(normal[0], r.normal0.w);
    o.normal1 = vec4(normal[1], r.normal1.w);
    o.normal2 = vec4(normal[2], r.normal2.w);
    o.normal3 = s.light.z > 0.5 ? vec4(s.light.xy, r.normal3.zw) : r.normal3;   // CG_OBJECT_LIGHT
    o.custom0 = (customs & 1) != 0 ? s.custom0 : r.custom0;
    o.custom1 = (customs & 2) != 0 ? s.custom1 : r.custom1;
    o.custom2 = (customs & 4) != 0 ? s.custom2 : r.custom2;
    o.custom3 = (customs & 8) != 0 ? s.custom3 : r.custom3;
    return o;
}

// How many of set s's instances there are.
uint cull_count(CullSet s) {
    return s.info.z < 0 ? uint(s.info.w) : min(COUNT(s.info.z), uint(s.info.w));
}

void Cull() {
    CullSet s = cull_set();
    if (uint(CG_ELEMENT) >= cull_count(s)) return;
    CullRecord r = INSTANCES(_First + CG_ELEMENT);
    mat4 m = cull_model(s, r);
    if (cull_level(s, m) == _Level) OUT_APPEND(cull_record(s, r, m));
}

void CullFlags() {
    CullSet s = cull_set();
    uint kept = 0u;
    if (uint(CG_ELEMENT) < cull_count(s)) {
        kept = cull_level(s, cull_model(s, INSTANCES(_First + CG_ELEMENT))) == _Level ? 1u : 0u;
    }
    FLAGS_WRITE(kept);
}

// Dispatched over the capacity with COUNT the compaction's count: element k writes the kth kept record.
void CullPlace() {
    CullSet s = cull_set();
    if (uint(CG_ELEMENT) >= cull_count(s)) return;
    CullRecord r = INSTANCES(_First + int(KEPT(CG_ELEMENT)));
    PLACED_WRITE(cull_record(s, r, cull_model(s, r)));
}

// The row of this dispatch's sets whose span holds e: the last whose first (component c of at) is at or below it.
int cull_row(int e, int c) {
    int lo = _SetFirst, hi = _SetFirst + _Sets - 1;
    while (lo < hi) {
        int mid = (lo + hi + 1) >> 1;
        if (SETS(mid).at[c] <= e) lo = mid; else hi = mid - 1;
    }
    return lo;
}

// Over this instance buffer's keys: each instance of its sets keyed by row and level, every other key _Culled.
void CullKey() {
    uint key = uint(_Culled), index = 0u;
    int row = cull_row(CG_ELEMENT, 1);
    CullSet s = SETS(row);
    int rank = CG_ELEMENT - s.at.y;
    if (rank < s.info.w && uint(rank) < cull_count(s)) {
        index = uint(s.at.x + rank);
        int level = cull_level(s, cull_model(s, INSTANCES(int(index))));
        if (level >= 0) key = uint(row) * 8u + uint(level);
    }
    KEYS_WRITE(key);
    INDICES_WRITE(index);
}

// Over this instance buffer's output: each level's region of each set, the nth kept record at the region's nth.
void CullGather() {
    int row = cull_row(CG_ELEMENT, 2);
    CullSet s = SETS(row);
    int region = (s.info.w + 3) & ~3, local = CG_ELEMENT - s.at.z;
    int level = local / region, rank = local - level * region, bin = row * 8 + level;
    if (uint(rank) >= COUNTS(bin)) return;
    CullRecord r = INSTANCES(int(SORTED(int(STARTS(bin)) + rank)));
    PLACED_WRITE(cull_record(s, r, cull_model(s, r)));
}
