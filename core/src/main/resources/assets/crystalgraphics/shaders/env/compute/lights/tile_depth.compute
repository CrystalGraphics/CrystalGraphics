// The window depth's range over each 4x4 pixels, the sky left out: the first of the entity tiles' two steps
// (tiles.compute reads 4x4 of these), so no invocation fetches a 16x16 tile's 256 depths in a row. Written: the least
// and the most window depth; (2, -1) where every pixel is sky or off the target. The pass samples the stage's depth
// (CgComputePass.sceneDepth).
#pragma kernel TileDepth 8 8 image

Properties {
    _Screen ("The full target's width and height", vec4) = (1, 1, 0, 0)
}

Images {
    RANGES ("Each 4x4 pixels' least and most window depth", rg32f, writeonly)
}

void TileDepth() {
    ivec2 first = CG_TEXEL.xy * 4, size = ivec2(_Screen.xy);
    bool reversed = cg_DepthParams.x > 0.5;
    float lo = 2.0, hi = -1.0;
    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            ivec2 px = first + ivec2(x, y);
            if (px.x >= size.x || px.y >= size.y) continue;
            float window = texelFetch(cg_DepthBuffer, px, 0).r;
            if (reversed ? window <= 0.0 : window >= 1.0) continue;
            lo = min(lo, window);
            hi = max(hi, window);
        }
    }
    RANGES_WRITE(vec4(lo, hi, 0.0, 0.0));
}
