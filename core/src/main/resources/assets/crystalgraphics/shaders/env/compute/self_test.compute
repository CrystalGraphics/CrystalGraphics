// CgComputeSelfTest's kernels: one per shape, each checked against values worked out in Java, so every tier (V, G43,
// G40, G33, CPU) must give the same buffers and images.
#pragma kernel Map map
#pragma kernel Pairs map
#pragma kernel Gather gather
#pragma kernel Append append
#pragma kernel Histogram scatter
#pragma kernel Extremes scatter
#pragma kernel Store scatter
#pragma kernel Paint 8 8 image
#pragma kernel Accumulate 8 8 image
#pragma kernel Counted map
#pragma kernel Bin general
#pragma kernel BinLowered scatter
#pragma kernel Big map
#pragma kernel Many append
#pragma kernel Doubled general
#pragma kernel After map
#pragma kernel Stuck general
#pragma fallback Bin BinLowered

struct Pair { vec4 a; uvec4 b; };

Buffers {
    INTS     ("Ints",      int,   readonly)
    FLOATS   ("Floats",    vec2,  readwrite)
    PAIRS    ("Pairs",     Pair,  readwrite)
    GATHERED ("Gathered",  float, writeonly)
    SPAWNS   ("Spawned",   uvec2, append)
    BINS     ("Bins",      uint,  counter)
    MINS     ("Minima",    float, readwrite)
    MAXS     ("Maxima",    int,   readwrite)
    STORED   ("Stored",    uvec4, writeonly)
    COUNTED  ("Counted",   uint,  readwrite)
    HALVES   ("Halves",    uint,  counter)
    BIG      ("Big",       uint,  writeonly)
    MANY     ("Many",      uint,  append)
    DOUBLED  ("Doubled",   uint,  readwrite)
    AFTER    ("After",     uint,  writeonly)
}

Images {
    PICTURE ("Picture", rgba8,   writeonly)
    ACCUM   ("Accum",   rgba32f, readwrite)
}

shared uint halves[2];
shared uint doubled[64];
shared uint stuck[64];

// Every element but each fifth doubles x and adds its int to y: an element left alone keeps what it held.
void Map() {
    int i = CG_ELEMENT;
    if (i % 5 == 0) return;
    vec2 f = FLOATS(i);
    FLOATS_WRITE(vec2(f.x * 2.0, f.y + float(INTS(i))));
}

void Pairs() {
    Pair p = PAIRS(CG_ELEMENT);
    p.a = p.a * 2.0 + vec4(1.0);
    p.b = p.b + uvec4(uint(CG_ELEMENT));
    PAIRS_WRITE(p);
}

void Gather() {
    int i = CG_ELEMENT;
    GATHERED_WRITE(float(INTS((i * 7) % INTS_LENGTH()) + INTS(i)));
}

// Every third element appends itself and its square; every ninth appends once more.
void Append() {
    uint i = uint(CG_ELEMENT);
    if (i % 3u == 0u) SPAWNS_APPEND(uvec2(i, i * i));
    if (i % 9u == 0u) SPAWNS_APPEND(uvec2(i + 1000u, 0u));
}

void Histogram() {
    BINS_INC(CG_ELEMENT % 8);
    BINS_ADD(CG_ELEMENT % 8, 2u);
}

void Extremes() {
    MINS_MIN(CG_ELEMENT % 4, float(CG_ELEMENT) - 10.0);
    MAXS_MAX(CG_ELEMENT % 4, CG_ELEMENT * 2);
}

void Store() {
    uint i = uint(CG_ELEMENT);
    STORED_STORE(STORED_LENGTH() - 1 - CG_ELEMENT, uvec4(i, i + 1u, i + 2u, 7u));
}

// A checkerboard of written texels: the others keep what the image held.
void Paint() {
    ivec2 p = CG_TEXEL.xy;
    if ((p.x + p.y) % 2 == 0) PICTURE_WRITE(vec4(float(p.x) / 63.0, float(p.y) / 63.0, 1.0, 1.0));
}

void Accumulate() {
    ivec2 p = CG_TEXEL.xy;
    ACCUM_WRITE(ACCUM_LOAD(p) + vec4(1.0, float(p.x), float(p.y), 0.0));
}

void Counted() {
    COUNTED_WRITE(uint(CG_ELEMENT) + 100u);
}

// Halves counted through shared memory: general, so below compute its fallback runs.
void Bin() {
    if (CG_LOCAL_INDEX < 2) halves[CG_LOCAL_INDEX] = 0u;
    barrier();
    if (CG_IN_RANGE) atomicAdd(halves[CG_ELEMENT % 2], 1u);
    barrier();
    if (CG_LOCAL_INDEX < 2) HALVES_ADD(CG_LOCAL_INDEX, halves[CG_LOCAL_INDEX]);
}

void BinLowered() {
    HALVES_INC(CG_ELEMENT % 2);
}

// Enough elements that the CPU tier runs them as many ranges at once.
void Big() {
    BIG_WRITE(uint(CG_ELEMENT) * 3u + 1u);
}

void Many() {
    if (CG_ELEMENT % 3 == 0) MANY_APPEND(uint(CG_ELEMENT));
}

// General with no fallback: below compute only its Java body runs it, between lowered kernels that write what it reads
// and read what it writes.
void Doubled() {
    doubled[CG_LOCAL_INDEX] = COUNTED(CG_ELEMENT) * 2u;
    barrier();
    DOUBLED_WRITE(doubled[CG_LOCAL_INDEX]);
}

void After() {
    AFTER_WRITE(DOUBLED(CG_ELEMENT) + 1u);
}

// General, with no fallback and no Java body: below compute it can run nowhere, and recording it says why.
void Stuck() {
    stuck[CG_LOCAL_INDEX] = 1u;
    barrier();
    if (CG_LOCAL_INDEX == 0) HALVES_ADD(0, stuck[0]);
}
