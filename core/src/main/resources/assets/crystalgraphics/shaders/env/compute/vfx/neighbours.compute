// A pool's neighbour grid (CgVfxWorldInput.NEIGHBOURS), Green's sort-based grid (NVIDIA, "Particle Simulation using
// CUDA", 2010): after a step Keys hashes each live particle's cell with its slot, CgGpuOps.sort orders the indices by
// key, and Runs marks where each key's run starts and ends. The next step's kinds walk the 27 cells round a particle.
// No atomic answers a value, so every tier runs it.
#pragma kernel Keys map
#pragma kernel Runs scatter

#include "crystalgraphics:shaders/lib/vfx/sim/fx_neighbour_hash.glsl"
#include "crystalgraphics:shaders/lib/vfx/fx_record.glsl"

Properties {
    _Cell  ("A cell's width, blocks",       float) = 1.0
    _Cells ("Hashed cells: a power of two", int)   = 1
    _RecordVectors ("A record's uvec4s: its pool's layout", int) = 4
}

Buffers {
    RECORDS ("Particles, after the step",                            uvec4,    readonly)
    LIVE    ("How many are alive",                                   uint,     readonly)
    KEYS    ("Each particle's hashed cell; sorted, the runs' order", uint,     readwrite)
    VALUES  ("Each particle's index, sorted with its key",           uint,     writeonly)
    RUNS    ("Each hashed cell's first sorted particle, then its end", uint,   writeonly)
}

void Keys() {
    uint key = 0u;
    if (CG_ELEMENT < int(LIVE(0))) {
        int e = CG_ELEMENT * _RecordVectors;
        vec3 p = uintBitsToFloat(RECORDS(e + FX_RECORD_POSITION_AGE).xyz);
        key = uint(fx_neighbour_hash(ivec3(floor(p / _Cell)), RECORDS(e + FX_RECORD_HEAT_ID).z, _Cells));
    }
    KEYS_WRITE(key);
    VALUES_WRITE(uint(CG_ELEMENT));
}

void Runs() {
    int live = int(LIVE(0));
    if (CG_ELEMENT >= live) return;
    uint key = KEYS(CG_ELEMENT);
    if (CG_ELEMENT == 0 || KEYS(CG_ELEMENT - 1) != key) RUNS_STORE(int(key) * 2, uint(CG_ELEMENT));
    if (CG_ELEMENT == live - 1 || KEYS(CG_ELEMENT + 1) != key) RUNS_STORE(int(key) * 2 + 1, uint(CG_ELEMENT + 1));
}
