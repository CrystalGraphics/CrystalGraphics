// Range (vfx-gpu §13.4), every particle pool's draws for one view: CgVfxRange.
//
// Slots are numbered across every pool, each pool's from _SlotFirst. Key, once per pool, gives each live particle a
// key, its slot if it may be on screen (inside the view, and not behind the scene's depth) and _AllSlots if not, so
// the culled sort past the end; and its index in its pool, which the sort carries. With _DepthBits 16 a slot that
// sorts takes its view depth in the low bits, far first, and a ribbon slot how many spawns ago it was born, newest
// first. CgGpuOps then sorts every pool's keys at once, counts each
// slot's visible particles and scans the counts into each slot's start. Place, once per pool, writes the index of
// each particle a slot draws into ORDER from the slot's list base: draws read the pool's records through it, whose
// drawn part the Step wrote. Objects writes the same particles as object records, for a mesh drawn per particle. Under crystalgraphics.vfx.orderedTies, Order first sorts each pool's live particles by spawn
// id, which the sort then keeps among equal keys: the atomics appending a pool's survivors order them anew each run.
#pragma kernel Order map
#pragma kernel Key map
#pragma kernel Place gather
#pragma kernel Objects gather

#include "crystalgraphics:shaders/lib/occlusion.glsl"
#include "crystalgraphics:shaders/lib/vfx/fx_world.glsl"
#include "crystalgraphics:shaders/lib/vfx/fx_rand.glsl"
#include "crystalgraphics:shaders/lib/vfx/fx_record.glsl"

Properties {
    _Plane0 ("The frustum's planes, JOML's order, camera-relative", vec4)  = (0, 0, 0, 1)
    _Plane1 ("Plane 1",                                             vec4)  = (0, 0, 0, 1)
    _Plane2 ("Plane 2",                                             vec4)  = (0, 0, 0, 1)
    _Plane3 ("Plane 3",                                             vec4)  = (0, 0, 0, 1)
    _Plane4 ("Plane 4",                                             vec4)  = (0, 0, 0, 1)
    _Plane5 ("Plane 5",                                             vec4)  = (0, 0, 0, 1)
    _Slots     ("The pool's slots",                                  int)   = 0
    _SlotFirst ("Its first slot among every pool's",                 int)   = 0
    _AllSlots  ("Every pool's slots: a culled particle's key",       int)   = 0
    _Texels ("Samples each curve of a row holds",                   int)   = 256
    _Floors ("1 when the pool's kinds land on a floor: Place writes it", int) = 0
    _Sequence    ("1 for a SEQUENCE pool: objects turned with their slot, sized by their size alone", int) = 0
    _DrawnFirst  ("Where the pool's records start in the order every draw reads",  int)       = 0
    _DepthBits   ("0, or 16 when a slot sorts by view depth",        int)       = 0
    _Ordered     ("1 when Order sorted INDICES by spawn id first",   int)       = 0
    _Pool        ("The pool's place among those keyed: Order's high bits", int) = 0
    _IdBits      ("The spawn id's bits Order keys by",               int)       = 24
    _RecordVectors ("A record's uvec4s: the pool's layout",          int)       = 4
    _DrawnStride ("Drawn elements a particle: its drawn part, then its drawn slots", int) = 1
    _Drawn       ("Its drawn slots, a bit each; 32 a mesh orientation in the slots' scale", int) = 0
    _ClipX       ("Projection times view: row 0",                    vec4)      = (1, 0, 0, 0)
    _ClipY       ("Row 1",                                           vec4)      = (0, 1, 0, 0)
    _ClipZ       ("Row 2",                                           vec4)      = (0, 0, 1, 0)
    _ClipW       ("Row 3",                                           vec4)      = (0, 0, 0, 1)
    _Eye         ("Projection [2][2], [2][3], [3][2], [3][3]",       vec4)      = (-1, -1, 0, 0)
    _CamForward  ("The camera's forward, world axes",                vec4)      = (0, 0, -1, 0)
    _CamUp       ("The camera's up, world axes",                     vec4)      = (0, 1, 0, 0)
    _Pyramid     ("The scene's depth, CgGpuOps.depthPyramid's",      sampler2D) = "white"
    _PyramidSize ("Its width, height and levels; no levels, no test", vec4)     = (0, 0, 0, 0)
    // CgWorldVoxelWindow.PROPERTIES
    _World         ("The voxel window: a block a texel",    sampler3D) = "black"
    _WorldSections ("Which of its sections are filled",     sampler3D) = "black"
    _WorldBaseX    ("Its lowest block, absolute: x",        int)       = 0
    _WorldBaseY    ("y",                                    int)       = 0
    _WorldBaseZ    ("z",                                    int)       = 0
    _WorldWrapX    ("That block's texel: x",                int)       = 0
    _WorldWrapY    ("y",                                    int)       = 0
    _WorldWrapZ    ("z",                                    int)       = 0
    _WorldLive     ("1 with a level, else 0: read nothing", int)       = 0
    _WorldDistance ("Distance to solid over FX_WORLD_FAR",  sampler3D) = "white"
}

// A particle's drawn part: CgVfxRecord.DRAWN_GLSL, which a test holds this line to.
struct FxDrawn { vec4 place; vec4 motion; vec4 state; vec4 light; vec4 color; vec4 scale; };

// A slot's origin, absolute: its whole blocks, and where in that block; within.w its ground from there, NaN for none;
// and its instance's rotation, a quaternion.
struct FxOrigin { ivec4 block; vec4 within; vec4 turn; };

// A particle as a mesh draws it: CgInstanceKind.OBJECT's record.
struct FxObject {
    vec4 model0; vec4 model1; vec4 model2; vec4 model3;
    vec4 normal0; vec4 normal1; vec4 normal2; vec4 normal3;
    vec4 custom0; vec4 custom1; vec4 custom2; vec4 custom3;
};

Buffers {
    RECORDS ("Particles",                                         uvec4,    readonly)
    DRAWN   ("Their drawn parts, at the same index",              FxDrawn,  readonly)
    LIVE    ("How many are alive",                                uint,     readonly)
    SLOTS   ("Each slot's origin from the camera, and its reach (below 0: one sphere's)", vec4, readonly)
    SORTS   ("Each slot's: 1 far to near, 2 + its newest spawn's id for a ribbon in spawn order", uint, readonly)
    KEYS    ("Keys",                                              uint,     writeonly)
    INDICES ("Indices, sorted by slot",                           uint,     readwrite)
    VISIBLE ("Each slot's visible particles",                     uint,     readonly)
    STARTS  ("Where each slot's run starts in INDICES",           uint,     readonly)
    BASES   ("Where each slot's records start in its pool's DRAWN", uint,   readonly)
    ORIGINS ("Each slot's origin, absolute",                      FxOrigin, readonly)
    ORDER   ("Each drawn particle's record in its pool, -1 for none: a float, as a buffer texture reads it", float, writeonly)
    OBJECTS ("The particles a mesh draws",                        FxObject, writeonly)
    FACINGS ("Each slot's mesh facing, CgVfxMeshFacing's six vec4s", vec4,     readonly)
}

bool range_outside(vec4 plane, vec3 c, float r) {
    return dot(plane.xyz, c) + plane.w < -r;
}

// A view depth as 16 bits, logarithmic from 1/64 to 1024 blocks: CgSortKey's distance, coarser.
uint range_depth(vec3 c) {
    float w = max(dot(_ClipW, vec4(c, 1.0)), 1.0 / 64.0);
    return uint(clamp((log2(w) + 6.0) / 16.0, 0.0, 1.0) * 65535.0);
}

// A distance from the eye as 16 bits, logarithmic as range_depth: Cascade's DistanceToView, Niagara's ViewDistance.
uint range_distance(vec3 c) {
    float d = max(length(c), 1.0 / 64.0);
    return uint(clamp((log2(d) + 6.0) / 16.0, 0.0, 1.0) * 65535.0);
}

// The pool, then dead after live, then the spawn id's low bits.
void Order() {
    bool live = CG_ELEMENT < int(LIVE(0));
    uint id = live ? RECORDS(CG_ELEMENT * _RecordVectors + FX_RECORD_HEAT_ID).y & ((1u << uint(_IdBits)) - 1u) : 0u;
    KEYS_WRITE((uint(_Pool) << uint(_IdBits + 1)) | (live ? 0u : 1u << uint(_IdBits)) | id);
    INDICES_WRITE(uint(CG_ELEMENT));
}

void Key() {
    uint key = uint(_AllSlots) << _DepthBits;
    uint e = _Ordered != 0 ? INDICES(CG_ELEMENT) : uint(CG_ELEMENT);
    if (CG_ELEMENT < int(LIVE(0))) {
        int at = int(e) * _RecordVectors;
        uvec4 heatId = RECORDS(at + FX_RECORD_HEAT_ID);
        uint owner = uint(_SlotFirst) + heatId.z;
        vec4 slot = SLOTS(int(owner));
        vec3 p = slot.xyz + uintBitsToFloat(RECORDS(at + FX_RECORD_POSITION_AGE).xyz);
        // Its size: a frame draws it where its step left it. A slot culled about its source (w below 0) is one sphere
        // of radius -w at its origin.
        bool source = slot.w < 0.0;
        vec3 c = source ? slot.xyz : p;
        float reach = source ? -slot.w : uintBitsToFloat(RECORDS(at + FX_RECORD_VELOCITY_SIZE).w) * slot.w;
        bool outside = range_outside(_Plane0, c, reach) || range_outside(_Plane1, c, reach)
                || range_outside(_Plane2, c, reach) || range_outside(_Plane3, c, reach)
                || range_outside(_Plane4, c, reach) || range_outside(_Plane5, c, reach);
        vec3 lo = c - vec3(reach), hi = c + vec3(reach);
        if (!outside && !cg_occluded(_Pyramid, _PyramidSize, _ClipX, _ClipY, _ClipZ, _ClipW, _Eye, lo, hi)) {
            key = owner << _DepthBits;
            // The slot's order (CgVfxRange.Sort) in its low 3 bits, a ribbon's next spawn id above; each drawn as
            // Cascade sorts (ParticleSystemRender.cpp, SortSpriteParticles): the largest first.
            uint order = SORTS(int(owner)), mode = order & 7u;
            if (_DepthBits > 0 && mode == 1u) key |= 65535u - range_depth(p);
            else if (_DepthBits > 0 && mode == 2u) key |= min((order >> 3u) - heatId.y, 65535u);
            else if (_DepthBits > 0 && mode == 3u) key |= 65535u - range_distance(p);
            else if (_DepthBits > 0 && mode == 4u) key |= 65535u - (heatId.y & 65535u);
            else if (_DepthBits > 0 && mode == 5u) key |= heatId.y & 65535u;
        }
    }
    KEYS_WRITE(key);
    INDICES_WRITE(e);
}

// The slot whose records hold element e of this pool's, numbered across every pool: the last base at or below it,
// and e's rank in it. A closed slot's base is the next one's.
int range_slot(int e, out int rank) {
    int lo = _SlotFirst, hi = _SlotFirst + _Slots - 1;
    while (lo < hi) {
        int mid = (lo + hi + 1) >> 1;
        if (int(BASES(mid)) <= e) lo = mid; else hi = mid - 1;
    }
    rank = e - int(BASES(lo));
    return lo;
}

void Place() {
    int rank;
    int lo = range_slot(CG_ELEMENT, rank);
    // Its drawn part's element: a draw finds its drawn slots at the next.
    ORDER_WRITE(rank < int(VISIBLE(lo)) ? float(int(INDICES(int(STARTS(lo)) + rank)) * _DrawnStride) : -1.0);
}

// What a mesh particle at p from slot's origin rests against (CG_OBJECT_SPARE): the nearest solid's surface in the
// voxel window, as its normal and how far p is above it; else the slot's flat ground; else none, a zero normal.
vec4 range_contact(int slot, vec3 p) {
    FxOrigin o = ORIGINS(slot);
    if (_WorldLive != 0) {
        vec4 field = fx_world_field(_WorldDistance, _WorldSections, ivec3(_WorldBaseX, _WorldBaseY, _WorldBaseZ),
                ivec3(_WorldWrapX, _WorldWrapY, _WorldWrapZ), o.block.xyz, o.within.xyz, p);
        float slope = length(field.xyz);
        if (field.w < FX_WORLD_FAR - 0.5 && slope > 1.0e-3) return vec4(field.xyz / slope, field.w);
    }
    return isnan(o.within.w) ? vec4(0.0) : vec4(0.0, 1.0, 0.0, p.y - o.within.w);
}

// A unit quaternion's rotation, JOML's Matrix3f.set(Quaternionfc): its three columns.
mat3 range_quat(vec4 q) {
    float xx = q.x * q.x, yy = q.y * q.y, zz = q.z * q.z, xy = q.x * q.y, xz = q.x * q.z, yz = q.y * q.z;
    float wx = q.w * q.x, wy = q.w * q.y, wz = q.w * q.z;
    return mat3(vec3(1.0 - 2.0 * (yy + zz), 2.0 * (xy + wz), 2.0 * (xz - wy)),
                vec3(2.0 * (xy - wz), 1.0 - 2.0 * (xx + zz), 2.0 * (yz + wx)),
                vec3(2.0 * (xz + wy), 2.0 * (yz - wx), 1.0 - 2.0 * (xx + yy)));
}

// JOML's rotationXYZ(ax, ay, az), term for term: its three columns.
mat3 range_turn(float ax, float ay, float az) {
    float sx = sin(ax), cx = cos(ax), sy = sin(ay), cy = cos(ay), sz = sin(az), cz = cos(az);
    float nm21 = -sx, nm22 = cx;
    float nm01 = nm21 * -sy, nm02 = nm22 * -sy;
    return mat3(vec3(cy * cz, nm01 * cz + cx * sz, nm02 * cz + sx * sz),
                vec3(cy * -sz, nm01 * -sz + cx * cz, nm02 * -sz + sx * cz),
                vec3(sy, nm21 * cy, nm22 * cy));
}

// Unreal's rotator (roll, pitch, yaw) as the host's quaternion: look.compute's look_rotator, CgUnits.rotatorToHost.
vec4 range_rotator(vec3 r) {
    vec3 h = r * 0.5, s = sin(h), c = cos(h);
    float x = c.x * s.y * s.z - s.x * c.y * c.z, y = -c.x * s.y * c.z - s.x * c.y * s.z;
    float z = c.x * c.y * s.z - s.x * s.y * c.z, w = c.x * c.y * c.z + s.x * s.y * s.z;
    return vec4(-x, -z, -y, w);
}

// Unreal's FindBetweenNormals: the shortest turn from a to b, half a turn about an axis across a when opposed.
vec4 range_between(vec3 a, vec3 b) {
    float w = 1.0 + dot(a, b);
    if (w < 1.0e-6) {
        vec3 axis = abs(a.x) > abs(a.z) ? vec3(-a.y, a.x, 0.0) : vec3(0.0, -a.z, a.y);
        return vec4(normalize(axis), 0.0);
    }
    return normalize(vec4(cross(a, b), w));
}

// A mesh particle's turn and size (CgVfxMeshFacing.model, its twin): its pre-rotation innermost, rolled from its seed,
// then sized, turned by its mesh's rotation and its own, faced as Niagara's NiagaraGetMeshFacingMatrix with Cascade's
// ups (ParticleSystemRender.cpp, CalculateParticleTransform), then rolled by its sprite rotation. Unreal's axes swap
// y and z, a reflection, so a facing's Y and Z land on the mesh's z and y and a roll's sense flips.
mat3 range_facing(int lo, vec3 toEye, vec3 velocity, float spin, mat3 own, vec3 size, uint bits) {
    vec4 f0 = FACINGS(lo * 6), f1 = FACINGS(lo * 6 + 1), f3 = FACINGS(lo * 6 + 3), f4 = FACINGS(lo * 6 + 4);
    vec4 f5 = FACINGS(lo * 6 + 5);
    vec3 up = vec3(0.0, 1.0, 0.0), worldX = vec3(1.0, 0.0, 0.0);
    vec3 eye = dot(toEye, toEye) > 0.0 ? normalize(toEye) : worldX;
    int mode = int(f0.x + 0.5), upMode = int(f0.y + 0.5), roll = int(f0.z + 0.5);
    mat3 facing = mat3(1.0);
    vec3 faced = worldX, locked = vec3(0.0);
    if (mode != 0) {
        faced = mode == 1 ? (dot(velocity, velocity) > 0.0 ? normalize(velocity) : up)
                : mode == 2 ? eye : -normalize(_CamForward.xyz);
        if (f0.w > 0.5) {
            locked = f1.w > 0.5 ? range_quat(ORIGINS(lo).turn) * f1.xyz : f1.xyz;
            if (abs(dot(faced, locked)) > 0.99) faced = abs(locked.y) > 0.99 ? worldX : up;
            vec3 y = normalize(cross(faced, locked));
            facing = mat3(cross(locked, y), locked, y);
        } else if (upMode == 3) {
            facing = range_quat(range_between(worldX, faced));
        } else {
            vec3 ref;
            if (upMode == 0 && mode == 3) {
                ref = _CamUp.xyz;
            } else {
                ref = upMode == 2 ? eye : up;
                if (abs(dot(faced, ref)) > 0.99) ref = up;
                float d = dot(faced, ref);
                if (abs(d) > 0.99) ref = worldX * -sign(d);
            }
            vec3 y = normalize(cross(faced, ref));
            facing = mat3(faced, cross(y, faced), y);
        }
    }
    mat3 m = facing * own * range_quat(FACINGS(lo * 6 + 2));
    if (mode != 0 && roll != 0) {
        vec3 axis = roll == 2 ? eye : f0.w > 0.5 ? locked : faced;
        float h = -0.5 * spin;
        m = range_quat(vec4(axis * sin(h), cos(h))) * m;
    }
    m = m * mat3(vec3(size.x * f5.x, 0.0, 0.0), vec3(0.0, size.y * f5.y, 0.0), vec3(0.0, 0.0, size.z * f5.z));
    if (f3.w > 0.5) {
        vec3 rolls = vec3(fx_rand(bits, 0u, 61u), fx_rand(bits, 0u, 62u), fx_rand(bits, 0u, 63u));
        if (f3.w > 2.5) rolls = vec3(rolls.x > 0.5 ? 1.0 : 0.0);   // a pick: one end or the other
        else if (f3.w < 1.5) rolls = vec3(rolls.x);
        m = m * range_quat(range_rotator(mix(f3.xyz, f4.xyz, rolls)));
    }
    return m;
}

void Objects() {
    int rank;
    int lo = range_slot(CG_ELEMENT, rank);
    FxObject o;
    o.model0 = vec4(0.0); o.model1 = vec4(0.0); o.model2 = vec4(0.0); o.model3 = vec4(0.0, 0.0, 0.0, 1.0);
    o.normal0 = vec4(0.0); o.normal1 = vec4(0.0); o.normal2 = vec4(0.0); o.normal3 = vec4(15.0, 15.0, 0.0, 1.0);
    o.custom0 = vec4(0.0); o.custom1 = vec4(0.0); o.custom2 = vec4(0.0); o.custom3 = vec4(0.0);
    if (rank < int(VISIBLE(lo))) {
        int e = int(INDICES(int(STARTS(lo)) + rank));
        FxDrawn r = DRAWN(e * _DrawnStride);
        float t = r.motion.w;
        // CgVfxFrame.particleMeshes: turned by its seed and spin, or as its mesh orientation says (Look's quaternion),
        // sized on each of its own axes by its size over life. A clip's particle plays in its effect's frame at its size
        // at birth, as the Step places its events there.
        float turn = r.state.x * 6.2831853 + r.state.y;
        // A facing mesh turns by its own orientation alone: Niagara's, and Cascade's, which drops its rotation payload.
        bool faces = _Sequence == 0 && FACINGS(lo * 6).x > 0.5;
        mat3 turned = _Sequence != 0 ? range_quat(ORIGINS(lo).turn)
                : (_Drawn & 32) != 0 ? range_quat(DRAWN(e * _DrawnStride + 1).scale)
                : faces ? mat3(1.0) : range_turn(turn * 1.7, turn * 2.3, turn);
        vec3 size = _Sequence != 0 ? vec3(uintBitsToFloat(RECORDS(e * _RecordVectors + FX_RECORD_VELOCITY_SIZE).w))
                : r.place.w * r.scale.xyz;
        mat3 model = _Sequence != 0 ? turned * mat3(vec3(size.x, 0.0, 0.0), vec3(0.0, size.y, 0.0), vec3(0.0, 0.0, size.z))
                : range_facing(lo, -(SLOTS(lo).xyz + r.place.xyz), r.motion.xyz, r.state.y, turned, size,
                        RECORDS(e * _RecordVectors + FX_RECORD_LIFE_SEED).y);
        o.model0 = vec4(model[0], 0.0);
        o.model1 = vec4(model[1], 0.0);
        o.model2 = vec4(model[2], 0.0);
        o.model3 = vec4(r.place.xyz, 1.0);
        // Matrix4f.normal: the inverse transpose; its spare lanes what it rests on.
        mat3 normal = determinant(model) != 0.0 ? transpose(inverse(model)) : mat3(0.0);
        vec4 contact = range_contact(lo, o.model3.xyz);
        o.normal0 = vec4(normal[0], contact.x);
        o.normal1 = vec4(normal[1], contact.y);
        o.normal2 = vec4(normal[2], contact.z);
        o.normal3 = vec4(mod(r.light.x, 16.0), floor(r.light.x / 16.0), 0.0, contact.w);
        // Its age: what a clip plays at.
        o.custom0 = vec4(r.motion.xyz, r.scale.w);
        o.custom1 = vec4(t, r.state.x, r.color.a, r.state.z);
        // w: its place in the order, which the cull's compaction loses: what a mesh factory's CG_PARTICLE_* reads.
        o.custom2 = vec4(r.color.rgb, float(_DrawnFirst + CG_ELEMENT));
    }
    OBJECTS_WRITE(o);
}
