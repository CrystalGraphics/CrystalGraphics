// Range (vfx-gpu §13.4), every particle pool's draws for one view: CgVfxRange.
//
// Slots are numbered across every pool, each pool's from _SlotFirst. Key, once per pool, gives each live particle a
// key, its slot if it may be on screen (inside the view, and not behind the scene's depth) and _AllSlots if not, so
// the culled sort past the end; and its index in its pool, which the sort carries. With _DepthBits 16 a slot that
// sorts takes its view depth in the low bits, far first, and a ribbon slot how many spawns ago it was born, newest
// first. CgGpuOps then sorts every pool's keys at once, counts each
// slot's visible particles and scans the counts into each slot's start. Place, once per pool, writes the particles a
// slot's draws read, in CgParticleBuffer's layout, from the slot's list base. Objects writes the same particles as
// object records, for a mesh drawn per particle. Both light each particle from the voxel window at its block
// (CgVfxVoxelWindow). Under crystalgraphics.vfx.orderedTies, Order first sorts each pool's live particles by spawn
// id, which the sort then keeps among equal keys: the atomics appending a pool's survivors order them anew each run.
#pragma kernel Order map
#pragma kernel Key map
#pragma kernel Place gather
#pragma kernel Objects gather

#include "crystalgraphics:shaders/lib/occlusion.glsl"
#include "crystalgraphics:shaders/lib/vfx/fx_world.glsl"
#include "crystalgraphics:shaders/lib/vfx/fx_rand.glsl"

Properties {
    _Plane0 ("The frustum's planes, JOML's order, camera-relative", vec4)  = (0, 0, 0, 1)
    _Plane1 ("Plane 1",                                             vec4)  = (0, 0, 0, 1)
    _Plane2 ("Plane 2",                                             vec4)  = (0, 0, 0, 1)
    _Plane3 ("Plane 3",                                             vec4)  = (0, 0, 0, 1)
    _Plane4 ("Plane 4",                                             vec4)  = (0, 0, 0, 1)
    _Plane5 ("Plane 5",                                             vec4)  = (0, 0, 0, 1)
    _Slots     ("The pool's slots",                                  int)   = 0
    _SlotFirst ("Its first slot among every pool's",                 int)   = 0
    _AllSlots  ("Every pool's slots: a culled particle's key",       int)   = 0
    _Alpha  ("How far the frame is from the last step to the next", float) = 1
    _Ahead  ("How far spin is pushed ahead, in seconds",            float) = 0
    _Texels ("Samples each curve of a row holds",                   int)   = 256
    _Floors ("1 when the pool's kinds land on a floor: Place writes it", int) = 0
    _StepSeconds ("A particle step's length: an object's age between its last two", float) = 0.0166667
    _Sequence    ("1 for a SEQUENCE pool: objects turned with their slot, sized by their size alone", int) = 0
    _DepthBits   ("0, or 16 when a slot sorts by view depth",        int)       = 0
    _Ordered     ("1 when Order sorted INDICES by spawn id first",   int)       = 0
    _Pool        ("The pool's place among those keyed: Order's high bits", int) = 0
    _IdBits      ("The spawn id's bits Order keys by",               int)       = 24
    _ClipX       ("Projection times view: row 0",                    vec4)      = (1, 0, 0, 0)
    _ClipY       ("Row 1",                                           vec4)      = (0, 1, 0, 0)
    _ClipZ       ("Row 2",                                           vec4)      = (0, 0, 1, 0)
    _ClipW       ("Row 3",                                           vec4)      = (0, 0, 0, 1)
    _Eye         ("Projection [2][2], [2][3], [3][2], [3][3]",       vec4)      = (-1, -1, 0, 0)
    _Pyramid     ("The scene's depth, CgGpuOps.depthPyramid's",      sampler2D) = "white"
    _PyramidSize ("Its width, height and levels; no levels, no test", vec4)     = (0, 0, 0, 0)
    // CgVfxVoxelWindow.PROPERTIES
    _World         ("The voxel window: a block a texel",    sampler3D) = "black"
    _WorldSections ("Which of its sections are filled",     sampler3D) = "black"
    _WorldBaseX    ("Its lowest block, absolute: x",        int)       = 0
    _WorldBaseY    ("y",                                    int)       = 0
    _WorldBaseZ    ("z",                                    int)       = 0
    _WorldWrapX    ("That block's texel: x",                int)       = 0
    _WorldWrapY    ("y",                                    int)       = 0
    _WorldWrapZ    ("z",                                    int)       = 0
    _WorldLive     ("1 with a level, else 0: read nothing", int)       = 0
    _WorldDistance ("Distance to solid over FX_WORLD_FAR",  sampler3D) = "white"
}

// A particle as a pool stores it: CgVfxRecord.GLSL, which a test holds this line to.
struct FxRecord { vec4 positionAge; vec4 previousLife; vec4 velocitySize; vec4 seedSpin; uvec4 idSlot; };

// A particle as a look reads it: CgParticleBuffer's record.
struct FxDrawn {
    vec4 place;
    vec4 motion;
    vec4 state;
    vec4 light;
    vec4 color;
    vec4 scale;
};

// A slot's origin, absolute: its whole blocks, and where in that block; within.w its ground from there, NaN for none;
// and its instance's rotation, a quaternion.
struct FxOrigin { ivec4 block; vec4 within; vec4 turn; };

// A particle as a mesh draws it: CgInstanceKind.OBJECT's record.
struct FxObject {
    vec4 model0; vec4 model1; vec4 model2; vec4 model3;
    vec4 normal0; vec4 normal1; vec4 normal2; vec4 normal3;
    vec4 custom0; vec4 custom1; vec4 custom2; vec4 custom3;
};

Buffers {
    RECORDS ("Particles",                                         FxRecord, readonly)
    LIVE    ("How many are alive",                                uint,     readonly)
    SLOTS   ("Each slot's origin from the camera, and its reach (below 0: one sphere's)", vec4, readonly)
    SORTS   ("Each slot's: 1 far to near, 2 + its newest spawn's id for a ribbon in spawn order", uint, readonly)
    KEYS    ("Keys",                                              uint,     writeonly)
    INDICES ("Indices, sorted by slot",                           uint,     readwrite)
    VISIBLE ("Each slot's visible particles",                     uint,     readonly)
    STARTS  ("Where each slot's run starts in INDICES",           uint,     readonly)
    BASES   ("Where each slot's records start in its pool's DRAWN", uint,   readonly)
    ORIGINS ("Each slot's origin, absolute",                      FxOrigin, readonly)
    CURVES  ("Each parameter row's curves and start values",      vec4,     readonly)
    DRAWN   ("The particles a look draws",                        FxDrawn,  writeonly)
    OBJECTS ("The particles a mesh draws",                        FxObject, writeonly)
}

bool range_outside(vec4 plane, vec3 c, float r) {
    return dot(plane.xyz, c) + plane.w < -r;
}

// A view depth as 16 bits, logarithmic from 1/64 to 1024 blocks: CgSortKey's distance, coarser.
uint range_depth(vec3 c) {
    float w = max(dot(_ClipW, vec4(c, 1.0)), 1.0 / 64.0);
    return uint(clamp((log2(w) + 6.0) / 16.0, 0.0, 1.0) * 65535.0);
}

// The pool, then dead after live, then the spawn id's low bits.
void Order() {
    bool live = CG_ELEMENT < int(LIVE(0));
    uint id = live ? RECORDS(CG_ELEMENT).idSlot.x & ((1u << uint(_IdBits)) - 1u) : 0u;
    KEYS_WRITE((uint(_Pool) << uint(_IdBits + 1)) | (live ? 0u : 1u << uint(_IdBits)) | id);
    INDICES_WRITE(uint(CG_ELEMENT));
}

void Key() {
    uint key = uint(_AllSlots) << _DepthBits;
    uint e = _Ordered != 0 ? INDICES(CG_ELEMENT) : uint(CG_ELEMENT);
    if (CG_ELEMENT < int(LIVE(0))) {
        FxRecord r = RECORDS(int(e));
        uint owner = uint(_SlotFirst) + r.idSlot.y;
        vec4 slot = SLOTS(int(owner));
        vec3 p = slot.xyz + r.positionAge.xyz;
        // Its size, and its last step's motion: a frame draws it anywhere between its last two steps. A slot culled
        // about its source (w below 0) is one sphere of radius -w at its origin.
        bool source = slot.w < 0.0;
        vec3 c = source ? slot.xyz : p;
        float reach = source ? -slot.w : r.velocitySize.w * slot.w + distance(r.positionAge.xyz, r.previousLife.xyz);
        bool outside = range_outside(_Plane0, c, reach) || range_outside(_Plane1, c, reach)
                || range_outside(_Plane2, c, reach) || range_outside(_Plane3, c, reach)
                || range_outside(_Plane4, c, reach) || range_outside(_Plane5, c, reach);
        vec3 lo = c - vec3(reach), hi = c + vec3(reach);
        if (!outside && !cg_occluded(_Pyramid, _PyramidSize, _ClipX, _ClipY, _ClipZ, _ClipW, _Eye, lo, hi)) {
            key = owner << _DepthBits;
            uint order = SORTS(int(owner));
            if (_DepthBits > 0 && order == 1u) key |= 65535u - range_depth(p);
            else if (_DepthBits > 0 && order >= 2u) key |= min(order - 2u - r.idSlot.x, 65535u);
        }
    }
    KEYS_WRITE(key);
    INDICES_WRITE(e);
}

// Where row's vec4s start: _Texels shape samples (each axis's scale, size), _Texels tint samples (rgb times intensity,
// opacity), its two start colours, its two start scales, then its domain's speeds (CgVfxGpuEmitter.writeCurves).
int range_row(uint row) {
    return int(row) * (2 * _Texels + 5);
}

// The curve from vec4 `at` at t, between its two nearest samples.
vec4 range_curve(int at, float t) {
    float x = clamp(t, 0.0, 1.0) * float(_Texels - 1);
    int i0 = int(floor(x));
    int i1 = min(i0 + 1, _Texels - 1);
    return mix(CURVES(at + i0), CURVES(at + i1), x - float(i0));
}

// Where r samples its curves (CgVfxCurveDomain.at): life progress, or its speed between its row's two.
float range_curve_at(FxRecord r, float progress) {
    vec4 speeds = CURVES(range_row(r.idSlot.w) + 2 * _Texels + 4);
    if (speeds.x < 0.0) return progress;
    return clamp((length(r.velocitySize.xyz) - speeds.x) / (speeds.y - speeds.x), 0.0, 1.0);
}

// What r draws as at life progress t: its size, each axis's scale of it, and its colour, alpha its opacity. Its starts
// are Niagara's non-uniform ranges: each channel and axis rolled on its own from its seed, between its row's two ends.
struct FxLook { float size; vec3 scale; vec4 color; };

FxLook range_look(FxRecord r, float t) {
    int at = range_row(r.idSlot.w), starts = at + 2 * _Texels;
    float u = range_curve_at(r, t);
    vec4 shape = range_curve(at, u), tint = range_curve(at + _Texels, u);
    uint bits = floatBitsToUint(r.seedSpin.x);
    vec4 colorRoll = vec4(fx_rand(bits, 0u, 20u), fx_rand(bits, 0u, 21u), fx_rand(bits, 0u, 22u), fx_rand(bits, 0u, 23u));
    vec3 scaleRoll = vec3(fx_rand(bits, 0u, 24u), fx_rand(bits, 0u, 25u), fx_rand(bits, 0u, 26u));
    FxLook l;
    l.size = r.velocitySize.w * shape.w;
    l.scale = mix(CURVES(starts + 2).xyz, CURVES(starts + 3).xyz, scaleRoll) * shape.xyz;
    l.color = mix(CURVES(starts), CURVES(starts + 1), colorRoll) * tint;
    return l;
}

// The slot whose records hold element e of this pool's, numbered across every pool: the last base at or below it,
// and e's rank in it. A closed slot's base is the next one's.
int range_slot(int e, out int rank) {
    int lo = _SlotFirst, hi = _SlotFirst + _Slots - 1;
    while (lo < hi) {
        int mid = (lo + hi + 1) >> 1;
        if (int(BASES(mid)) <= e) lo = mid; else hi = mid - 1;
    }
    rank = e - int(BASES(lo));
    return lo;
}

// Block and sky light, 0 to 15, at p from slot's origin: full with no level, or where the window does not know.
vec2 range_light(int slot, vec3 p) {
    if (_WorldLive == 0) return vec2(15.0);
    FxOrigin o = ORIGINS(slot);
    ivec3 b = fx_world_block(o.block.xyz, o.within.xyz, p);
    return fx_world_light(_World, _WorldSections, ivec3(_WorldBaseX, _WorldBaseY, _WorldBaseZ),
            ivec3(_WorldWrapX, _WorldWrapY, _WorldWrapZ), b, vec2(15.0));
}

// Block and sky light as one word, block + 16 sky: CG_PARTICLE_LIGHT unpacks it.
float range_light_word(vec2 light) {
    return floor(light.x + 0.5) + 16.0 * floor(light.y + 0.5);
}

// The floor under a particle at p from slot's origin (CG_PARTICLE_FLOOR): its height over it, and 1; or (0, 0) for
// none. The Step's floor: the window's where it knows, else the slot's flat ground.
vec2 range_floor(int slot, vec3 p, float previousY) {
    FxOrigin o = ORIGINS(slot);
    float floorY = o.within.w;
    if (_WorldLive != 0) {
        floorY = fx_world_floor(_World, _WorldSections, ivec3(_WorldBaseX, _WorldBaseY, _WorldBaseZ),
                ivec3(_WorldWrapX, _WorldWrapY, _WorldWrapZ), o.block.xyz, o.within.xyz, p, previousY);
    }
    return isnan(floorY) ? vec2(0.0) : vec2(p.y - floorY, 1.0);
}

void Place() {
    int rank;
    int lo = range_slot(CG_ELEMENT, rank);
    FxDrawn d;
    d.place = vec4(0.0);
    d.motion = vec4(0.0);
    d.state = vec4(0.0);
    d.light = vec4(range_light_word(vec2(15.0)), 0.0, 0.0, 0.0);
    d.color = vec4(0.0);
    d.scale = vec4(0.0);
    if (rank < int(VISIBLE(lo))) {
        FxRecord r = RECORDS(int(INDICES(int(STARTS(lo)) + rank)));
        float t = min(r.positionAge.w / r.previousLife.w, 1.0);
        FxLook look = range_look(r, t);
        d.place = vec4(r.previousLife.xyz + (r.positionAge.xyz - r.previousLife.xyz) * _Alpha, look.size);
        d.motion = vec4(r.velocitySize.xyz, t);
        d.state = vec4(r.seedSpin.x, r.seedSpin.y + r.seedSpin.z * _Ahead, r.seedSpin.w, look.color.a);
        d.color = look.color;
        d.scale = vec4(look.scale, r.positionAge.w);
        // Light packed into one lane, its spawn id in the next: what a trail or ribbon of it reads (CG_PARTICLE_ID).
        vec2 ground = _Floors != 0 ? range_floor(lo, d.place.xyz, r.previousLife.y) : vec2(0.0);
        d.light = vec4(range_light_word(range_light(lo, d.place.xyz)), float(r.idSlot.x & 16777215u), ground);
    }
    DRAWN_WRITE(d);
}

// What a mesh particle at p from slot's origin rests against (CG_OBJECT_SPARE): the nearest solid's surface in the
// voxel window, as its normal and how far p is above it; else the slot's flat ground; else none, a zero normal.
vec4 range_contact(int slot, vec3 p) {
    FxOrigin o = ORIGINS(slot);
    if (_WorldLive != 0) {
        vec4 field = fx_world_field(_WorldDistance, _WorldSections, ivec3(_WorldBaseX, _WorldBaseY, _WorldBaseZ),
                ivec3(_WorldWrapX, _WorldWrapY, _WorldWrapZ), o.block.xyz, o.within.xyz, p);
        float slope = length(field.xyz);
        if (field.w < FX_WORLD_FAR - 0.5 && slope > 1.0e-3) return vec4(field.xyz / slope, field.w);
    }
    return isnan(o.within.w) ? vec4(0.0) : vec4(0.0, 1.0, 0.0, p.y - o.within.w);
}

// A unit quaternion's rotation, JOML's Matrix3f.set(Quaternionfc): its three columns.
mat3 range_quat(vec4 q) {
    float xx = q.x * q.x, yy = q.y * q.y, zz = q.z * q.z, xy = q.x * q.y, xz = q.x * q.z, yz = q.y * q.z;
    float wx = q.w * q.x, wy = q.w * q.y, wz = q.w * q.z;
    return mat3(vec3(1.0 - 2.0 * (yy + zz), 2.0 * (xy + wz), 2.0 * (xz - wy)),
                vec3(2.0 * (xy - wz), 1.0 - 2.0 * (xx + zz), 2.0 * (yz + wx)),
                vec3(2.0 * (xz + wy), 2.0 * (yz - wx), 1.0 - 2.0 * (xx + yy)));
}

// JOML's rotationXYZ(ax, ay, az), term for term: its three columns.
mat3 range_turn(float ax, float ay, float az) {
    float sx = sin(ax), cx = cos(ax), sy = sin(ay), cy = cos(ay), sz = sin(az), cz = cos(az);
    float nm21 = -sx, nm22 = cx;
    float nm01 = nm21 * -sy, nm02 = nm22 * -sy;
    return mat3(vec3(cy * cz, nm01 * cz + cx * sz, nm02 * cz + sx * sz),
                vec3(cy * -sz, nm01 * -sz + cx * cz, nm02 * -sz + sx * cz),
                vec3(sy, nm21 * cy, nm22 * cy));
}

void Objects() {
    int rank;
    int lo = range_slot(CG_ELEMENT, rank);
    FxObject o;
    o.model0 = vec4(0.0); o.model1 = vec4(0.0); o.model2 = vec4(0.0); o.model3 = vec4(0.0, 0.0, 0.0, 1.0);
    o.normal0 = vec4(0.0); o.normal1 = vec4(0.0); o.normal2 = vec4(0.0); o.normal3 = vec4(15.0, 15.0, 0.0, 1.0);
    o.custom0 = vec4(0.0); o.custom1 = vec4(0.0); o.custom2 = vec4(0.0); o.custom3 = vec4(0.0);
    if (rank < int(VISIBLE(lo))) {
        FxRecord r = RECORDS(int(INDICES(int(STARTS(lo)) + rank)));
        float t = min(r.positionAge.w / r.previousLife.w, 1.0);
        FxLook look = range_look(r, t);
        // CgVfxFrame.particleMeshes: turned by its seed and spin, sized on each of its own axes by its size over life.
        // A clip's particle plays in its effect's frame at its own size, as the Step places its events there.
        float turn = r.seedSpin.x * 6.2831853 + r.seedSpin.y;
        mat3 turned = _Sequence != 0 ? range_quat(ORIGINS(lo).turn) : range_turn(turn * 1.7, turn * 2.3, turn);
        vec3 size = _Sequence != 0 ? vec3(r.velocitySize.w) : look.size * look.scale;
        vec3 inverse = vec3(size.x != 0.0 ? 1.0 / size.x : 0.0, size.y != 0.0 ? 1.0 / size.y : 0.0,
                size.z != 0.0 ? 1.0 / size.z : 0.0);
        o.model0 = vec4(turned[0] * size.x, 0.0);
        o.model1 = vec4(turned[1] * size.y, 0.0);
        o.model2 = vec4(turned[2] * size.z, 0.0);
        o.model3 = vec4(r.previousLife.xyz + (r.positionAge.xyz - r.previousLife.xyz) * _Alpha, 1.0);
        // Matrix4f.normal: the inverse transpose, the rotation over each axis's size; its spare lanes what it rests on
        vec4 contact = range_contact(lo, o.model3.xyz);
        o.normal0 = vec4(turned[0] * inverse.x, contact.x);
        o.normal1 = vec4(turned[1] * inverse.y, contact.y);
        o.normal2 = vec4(turned[2] * inverse.z, contact.z);
        o.normal3 = vec4(range_light(lo, o.model3.xyz), 0.0, contact.w);
        // Its age between its last two steps, as its place is: what a clip plays at.
        o.custom0 = vec4(r.velocitySize.xyz, max(r.positionAge.w - (1.0 - _Alpha) * _StepSeconds, 0.0));
        o.custom1 = vec4(t, r.seedSpin.x, look.color.a, r.seedSpin.w);
        o.custom2 = vec4(look.color.rgb, 0.0);
    }
    OBJECTS_WRITE(o);
}
